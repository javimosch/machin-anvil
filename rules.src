// ---- rules lanes: deterministic, model-free lanes (.rules.json packs) ----
// ANVIL_EXPERTS=dom:file.rules.json loads a rulepack instead of a head.
// When the routed/pinned expert is a rules lane, decide() synthesizes a
// probability vector from rule evaluation — minconf/conformal/action work
// unchanged downstream. A rule hit is a confident answer (its class at its
// declared score); no hit answers the default_class (usually "none").

var cur_text = "" // raw state text, set by head_prefill for rule eval
var cur_scores_json = "{}" // raw {"k":v} scores from the request (score-policy lanes)
var cur_unchecked = []string{} // declared score inputs absent from the request
var cur_matched = "" // "class:kind" of the rule that produced the verdict

type RulePack struct {
	head Head              // optional fallback head: evaluated when no rule fires
	names []string
	nr int
	default_ix int
	probs int
	rk_class []int
	rk_kind []string
	rk_arg []string
	rk_score []float
	domlist []string
	wordlist []string
	rk_dmix []int
}

var rulepacks = []RulePack{}
var hd_rules_ix = -1   // -1 = normal head lane; >=0 index into rulepacks

func ends_with(s, suf) (ok) {
	ok = 0
	if len(s) >= len(suf) && substr(s, len(s)-len(suf), len(s)) == suf { ok = 1 }
	return
}

type rp_rule struct {
	class string
	kind string
	arg string
	score float
}
type rp_file struct {
	classes []string
	default_class string
	head string            // optional .head path (relative to this file): fallback scorer
	rules []rp_rule
}

// map each rule kind=domains arg (file path, relative to the rules file)
// to a loaded domain set; rules reference it via rk_dmix.
func load_rulepack(path) (ix) {
	b := read_file(path)
	f := parse(b, rp_file{})
	if len(f.classes) == 0 { println("rules pack has no classes: " + path)  exit(1) }
	p := RulePack{}
	p.names = f.classes
	p.nr = len(f.classes)
	p.probs = alloc(p.nr * 4)
	p.default_ix = 0
	cix := make(map[string]int)
	i := 0
	while i < p.nr { cix[f.classes[i]] = i  if f.classes[i] == f.default_class { p.default_ix = i }  i = i + 1 }
	base := ""
	sl := index(path, "/")
	_ = sl
	// dirname of path
	j := len(path) - 1
	while j >= 0 { if substr(path, j, j+1) == "/" { base = substr(path, 0, j+1)  j = -1 }  j = j - 1 }
	if len(f.head) > 0 {
		hp := f.head
		if len(base) > 0 && substr(hp, 0, 1) != "/" { hp = base + hp }
		p.head = read_head(hp)
		println("rules lane " + path + ": fallback head " + hp + " (" + str(p.head.nr) + " routes)")
	}
	i = 0
	while i < len(f.rules) {
		r := f.rules[i]
		ci := cix[r.class]
		_ = i
	p.rk_class = append(p.rk_class, ci)
		p.rk_kind = append(p.rk_kind, r.kind)
		p.rk_score = append(p.rk_score, r.score)
		dmix := -1
		arg := r.arg
		if r.kind == "domains" {
			dp := arg
			if len(base) > 0 && substr(arg, 0, 1) != "/" { dp = base + arg }
			// sorted []string (file order) + binary search — a map dropped
			// entries at 200k+ scale (sparse silent misses on real lists).
			ds := []string{}
			lines := split(read_file(dp), "\n")
			k := 0
			while k < len(lines) {
				d := trim(to_lower(lines[k]))
				if len(d) > 0 && substr(d, 0, 1) != "#" { ds = append(ds, d) }
				k = k + 1
			}
			mi := 0
			while mi < len(ds) { p.domlist = append(p.domlist, ds[mi])  mi = mi + 1 }
			p.domlist = sort(p.domlist)
			dmix = 0
		}
		if r.kind == "words" {
			wp := arg
			if len(base) > 0 && substr(arg, 0, 1) != "/" { wp = base + arg }
			ws := []string{}
			lines := split(read_file(wp), "\n")
			k := 0
			while k < len(lines) {
				w := trim(to_lower(lines[k]))
				if len(w) > 0 && substr(w, 0, 1) != "#" { ws = append(ws, w) }
				k = k + 1
			}
			mi := 0
			while mi < len(ws) { p.wordlist = append(p.wordlist, ws[mi])  mi = mi + 1 }
			p.wordlist = sort(p.wordlist)
			dmix = 0
			arg = ""
		}
		p.rk_dmix = append(p.rk_dmix, dmix)
		p.rk_arg = append(p.rk_arg, arg)
		i = i + 1
	}
	rulepacks = append(rulepacks, p)
	ix = len(rulepacks) - 1
	return
}

// ---- deobfuscation: normalize evasion forms before rule eval ----
// Lowercase + unicode lookalike fold + at/dot word substitution + leetspeak
// + spaced-letter join + letter-flood squeeze. Rules see the normalized text;
// heads still get the raw string (their features were trained on it).

// unicode lookalikes (literal UTF-8) -> ascii, then spoken substitutions.
// POSIX ERE has no \xNN — the lookalike chars are literal in the patterns.
var deob_from = []string{"а","о","е","с","р","х","и","α","ο","[[]at[]]","[(]at[]]","{at}","[[]dot[]]","[(]dot[]]","{dot}","-at-","-dot-"," at "," dot "," @ "," [.] ","@ ","[.] "}
var deob_to = []string{"a","o","e","c","p","x","u","a","o","@","@","@",".",".",".","@",".","@",".","@",".","@","."}

// fold leet only inside tokens that contain a letter — keeps pure digit
// runs (phones, cards) untouched for the digits/luhn/iban rules.
func fold_leet(t) (out) {
	out = ""
	i := 0
	while i < len(t) {
		j := i
		hasalpha := 0
		while j < len(t) {
			c := byte_at(bytes(t), j)
			if (c >= 97 && c <= 122) { hasalpha = 1 }
			if c == 32 || c == 46 || c == 44 || c == 59 || c == 33 || c == 63 { break }
			j = j + 1
		}
		k := i
		while k < j {
			c := byte_at(bytes(t), k)
			ch := bytes_str(bytes_sub(bytes(t), k, k+1))
			if hasalpha == 1 {
				if c == 48 { ch = "o" }
				if c == 49 { ch = "i" }
				if c == 51 { ch = "e" }
				if c == 52 { ch = "a" }
				if c == 53 { ch = "s" }
				if c == 55 { ch = "t" }
			}
			out = out + ch
			k = k + 1
		}
		out = out + bytes_str(bytes_sub(bytes(t), j, j+1))
		i = j + 1
	}
	return
}

// "f r e e" -> "free": join runs of single letters separated by spaces.
func join_spaced(t) (out) {
	out = ""
	i := 0
	while i < len(t) {
		c := byte_at(bytes(t), i)
		// single letter + space + single letter -> skip the space
		if i+2 < len(t) && byte_at(bytes(t), i+1) == 32 {
			c2 := byte_at(bytes(t), i+2)
			if (c >= 97 && c <= 122) && (c2 >= 97 && c2 <= 122) && (i == 0 || byte_at(bytes(t), i-1) == 32) {
				out = out + bytes_str(bytes_sub(bytes(t), i, i+1))
				i = i + 2
				continue
			}
		}
		out = out + bytes_str(bytes_sub(bytes(t), i, i+1))
		i = i + 1
	}
	return
}

// squeeze 3+ repeated letters to 2 ("loooove" -> "loove")
func squeeze_floods(t) (out) {
	out = ""
	run := 0
	prev := -1
	i := 0
	while i < len(t) {
		c := byte_at(bytes(t), i)
		if c == prev { run = run + 1 } else { run = 1 }
		prev = c
		if run <= 2 || c < 97 || c > 122 { out = out + bytes_str(bytes_sub(bytes(t), i, i+1)) }
		i = i + 1
	}
	return
}

func deobfuscate(t) (out) {
	out = to_lower(t)
	i := 0
	while i < len(deob_from) {
		out = regex_replace(out, deob_from[i], deob_to[i])
		i = i + 1
	}
	out = join_spaced(out)
	out = fold_leet(out)
	out = squeeze_floods(out)
	return
}

// binary search in a sorted []string — domains lists keep file order
func in_sorted(list, target) (found) {
	found = 0
	lo := 0
	hi := len(list) - 1
	while lo <= hi {
		mid := lo + (hi - lo) / 2
		m := list[mid]
		if m == target { found = 1  return }
		if m < target { lo = mid + 1 } else { hi = mid - 1 }
	}
	return
}

// word tokens: [a-z0-9']+ runs (for wordlist membership checks)
func text_words(t) (out) {
	out = []string{}
	cur := ""
	i := 0
	while i <= len(t) {
		c := ""
		if i < len(t) { c = substr(t, i, i+1) }
		if (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "'" { cur = cur + c } else {
			if len(cur) > 0 { out = append(out, cur) }
			cur = ""
		}
		i = i + 1
	}
	return
}

// ---- matchers ----

// digit-run at position >= nmin digits
func has_digit_run(t, nmin) (ok) {
	ok = 0
	run := 0
	i := 0
	while i < len(t) {
		c := substr(t, i, i+1)
		if c >= "0" && c <= "9" {
			run = run + 1
			if run >= nmin { ok = 1  return }
		} else { run = 0 }
		i = i + 1
	}
	return
}

// card candidates: digit groups joined by single space/dash separators
// ("4111 1111 1111 1111" -> "4111111111111111"); phones stay out (<12 digits).
func card_candidates(t) (out) {
	out = []string{}
	cur := ""
	i := 0
	while i < len(t) {
		c := substr(t, i, i+1)
		if c >= "0" && c <= "9" { cur = cur + c } else {
			nxt := ""
			if i+1 < len(t) { nxt = substr(t, i+1, i+2) }
			if (c == " " || c == "-") && len(cur) > 0 && nxt >= "0" && nxt <= "9" {
			} else {
				if len(cur) >= 12 { out = append(out, cur) }
				cur = ""
			}
		}
		i = i + 1
	}
	if len(cur) >= 12 { out = append(out, cur) }
	return
}

func luhn_ok(digits) (ok) {
	ok = 0
	sum := 0
	dbl := 0
	i := len(digits) - 1
	while i >= 0 {
		d := byte_at(bytes(digits), i) - 48
		if dbl == 1 { d = d * 2  if d > 9 { d = d - 9 } }
		sum = sum + d
		dbl = 1 - dbl
		i = i - 1
	}
	if len(digits) >= 12 && sum % 10 == 0 { ok = 1 }
	return
}

// IBAN mod-97: convert letters to digits (A=10..Z=35), accumulate remainder
func iban_ok(t) (ok) {
	ok = 0
	// find IBAN-ish token: CC + 2 digits + up to 30 alnum (spaces allowed)
	m := regex_find(t, "[A-Za-z]{2}[0-9]{2}[ 0-9A-Za-z]{11,32}")
	if len(m) == 0 { return }
	// move first 4 chars to end, map letters
	seq := substr(m, 4, len(m)) + substr(m, 0, 4)
	rem := 0
	i := 0
	while i < len(seq) {
		ch := byte_at(bytes(seq), i)
		if ch == 32 { i = i + 1  continue }
		if ch >= 48 && ch <= 57 { rem = (rem * 10 + (ch - 48)) % 97 } else {
			a := ch
			if a >= 97 { a = a - 32 }
			v := a - 55
			if v < 10 || v > 35 { return }
			rem = (rem * 100 + v) % 97
		}
		i = i + 1
	}
	if rem == 1 { ok = 1 }
	return
}

// domain-shaped tokens in text: [a-z0-9-]+(.[a-z0-9-]+)+ — caller checks
// each token (and its parent suffixes) against a domain set.
func text_domains(t) (out) {
	out = []string{}
	cur := ""
	i := 0
	while i <= len(t) {
		c := ""
		if i < len(t) { c = substr(t, i, i+1) }
		if (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "-" || c == "." {
			cur = cur + c
		} else {
			if len(cur) > 3 && index(cur, ".") >= 0 { out = append(out, cur) }
			cur = ""
		}
		i = i + 1
	}
	return
}

func rule_fires(p, j, lowtext) (hit) {
	hit = 0
	kind := p.rk_kind[j]
	arg := p.rk_arg[j]
	if kind == "regex" { if regex_match(lowtext, arg) { hit = 1 } }
	// raw pass too: leet fold can rewrite digit+letter tokens (crypto
	// addresses, IDs) that the pattern was written to match
	if kind == "regex" && hit == 0 { if regex_match(to_lower(cur_text), arg) { hit = 1 } }
	if kind == "contains" { if index(lowtext, arg) >= 0 { hit = 1 } }
	if kind == "digits" { hit = has_digit_run(lowtext, 9) }
	if kind == "luhn" {
		runs := card_candidates(lowtext)
		i := 0
		while i < len(runs) { if luhn_ok(runs[i]) == 1 { hit = 1  return }  i = i + 1 }
	}
	if kind == "iban" { hit = iban_ok(cur_text) }
	// numeric score inputs: arg = "input:threshold" (ge/le) or "input" (missing)
	if kind == "ge" || kind == "le" {
		colon := index(arg, ":")
		if colon > 0 {
			iname := substr(arg, 0, colon)
			thresh := parse_float(substr(arg, colon+1, len(arg)))
			tok, err := json_get(cur_scores_json, "." + iname)
			if err == "" {
				v := parse_float(tok)
				if kind == "ge" && v >= thresh { hit = 1 }
				if kind == "le" && v <= thresh { hit = 1 }
			}
		}
	}
	if kind == "missing" {
		tok, err := json_get(cur_scores_json, "." + arg)
		_ = tok
		if err == "notfound" || err == "parse" { hit = 1 }
	}
	if kind == "words" {
		wt := text_words(lowtext)
		wt2 := text_words(to_lower(cur_text))
		mi := 0
		while mi < len(wt2) { wt = append(wt, wt2[mi])  mi = mi + 1 }
		i := 0
		while i < len(wt) {
			if in_sorted(p.wordlist, wt[i]) == 1 { hit = 1  return }
			i = i + 1
		}
	}
	if kind == "domains" {
		ds := p.domlist
		// check deobfuscated text AND raw-lowercase text: the leet fold
		// catches "ph1shing" -> "phishing" evasion, but it also rewrites
		// digit+letter domain tokens ("31job" -> "eijob") — the raw pass
		// keeps already-clean domains findable.
		toks := text_domains(lowtext)
		t2 := text_domains(to_lower(cur_text))
		mi := 0
		while mi < len(t2) { toks = append(toks, t2[mi])  mi = mi + 1 }
		i := 0
		while i < len(toks) {
			d := toks[i]
			scanning := 1
			while scanning == 1 {
				if in_sorted(ds, d) == 1 { hit = 1  return }
				di := index(d, ".")
				if di < 0 { scanning = 0 } else { d = substr(d, di+1, len(d)) }
			}
			i = i + 1
		}
	}
	return
}

// evaluate a rulepack against cur_text; fills hd_* as a confident head would.
func rules_decide(ix) (best) {
	p := rulepacks[ix]
	hd_names = p.names
	hd_nr = p.nr
	hd_probs = p.probs
	i := 0
	while i < p.nr { poke_f32(hd_probs, i*4, 0.0)  i = i + 1 }
	low := deobfuscate(cur_text)
	best = p.default_ix
	wscore := 0.99
	fired := -1
	j := 0
	cur_matched = ""
	while j < len(p.rk_class) {
		if rule_fires(p, j, low) == 1 {
			best = p.rk_class[j]
			wscore = p.rk_score[j]
			fired = j
			if wscore <= 0.0 || wscore > 0.999 { wscore = 0.999 }
			j = len(p.rk_class)
		}
		j = j + 1
	}
	// unchecked honesty: which declared score inputs were absent this request
	cur_unchecked = []string{}
	j = 0
	while j < len(p.rk_class) {
		if p.rk_kind[j] == "ge" || p.rk_kind[j] == "le" {
			colon := index(p.rk_arg[j], ":")
			if colon > 0 {
				tok, err := json_get(cur_scores_json, "." + substr(p.rk_arg[j], 0, colon))
				_ = tok
				if err != "" {
					name := substr(p.rk_arg[j], 0, colon)
					seen := 0
					k := 0
					while k < len(cur_unchecked) { if cur_unchecked[k] == name { seen = 1 }  k = k + 1 }
					if seen == 0 { cur_unchecked = append(cur_unchecked, name) }
				}
			}
		}
		j = j + 1
	}
	if fired >= 0 { cur_matched = p.names[best] + ":" + p.rk_kind[fired] }
	if best == p.default_ix && p.head.nr > 0 {
		// rules floor missed -> fall through to the lane's head
		set_head(p.head)
		best = head_best(p.head)
		return
	}
	rem := (1.0 - wscore) / float(p.nr - 1)
	i = 0
	while i < p.nr { if i != best { poke_f32(hd_probs, i*4, rem) }  i = i + 1 }
	poke_f32(hd_probs, best*4, wscore)
	return
}
