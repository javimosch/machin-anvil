// colibri serve — OpenAI-compatible inference server in pure MFL.
// Build: machin encode framework/machweb.src engine.src serve.src > serve.mfl
// Endpoints: GET /v1/models, POST /v1/chat/completions (stream + non-stream),
// POST /v1/decide|noul|score|assess (head primitives), POST /v1/route (the
// dispatcher: assess + gates + optional execute with head/trunk agreement).
// Single-flight: one generation at a time via a mutex-as-service channel;
// the winning request runs inference in ITS goroutine (worker pool is shared,
// exclusive under the lock). Single-slot KV prefix cache makes multi-turn
// chats prefill only the delta.

type FnDef struct {
	name string
	description string
	arguments string
}

type MsgTC struct {
	id string
	function FnDef
}

type ChatMsg struct {
	role string
	content string
	tool_call_id string
	tool_calls []MsgTC
}

type ToolDef struct {
	function FnDef
}

type ChatReq struct {
	model string
	stream bool
	temperature float
	top_p float
	max_tokens int
	seed int
	messages []ChatMsg
	tools []ToolDef
	reqbody string
}

var model_id = "tinyllama-1.1b-q80"
var mu_acq = make(chan int)
var mu_rel = make(chan int)
var met_acq = make(chan int)
var met_rel = make(chan int)
var boot_ms = 0
var rt_tc = 0.0
var rt_del = 0.0
var rt_lat_sum = 0.0
var rt_lat_cnt = 0.0
var lane_req = []float{}
var lane_del = []float{}
var lane_ss_sum = []float{}
var lane_ss_cnt = []float{}
var lane_names_out = []string{}
var ep_names = []string{"chat", "decide", "assess", "noul", "score", "systemone"}
var ep_counts = []float{0, 0, 0, 0, 0, 0}

// ---- skills: trigger-matched guidance injected into the system prompt.
// In-context "finetuning": curated instructions + few-shot examples make the
// small model far more reliable at a task, without changing its weights.
type Skill struct {
	name string
	triggers []string
	priority int
	when string   // "tools" = only inject when the request carries tools; "" = always eligible
	body string
}
var skills = []Skill{}
var skills_max = 2 // inject at most this many matched skills

func parse_skill(content) (sk) {
	sk = Skill{name: "", priority: 0, when: "", body: ""}
	trg := []string{}
	sep := index(content, "\n---")
	head := content
	if sep >= 0 { head = substr(content, 0, sep)  sk.body = trim(substr(content, sep+4, len(content))) }
	lines := split(head, "\n")
	i := 0
	while i < len(lines) {
		ln := trim(lines[i])
		if has_prefix(ln, "name:") { sk.name = trim(substr(ln, 5, len(ln))) }
		if has_prefix(ln, "priority:") { sk.priority = parse_int(trim(substr(ln, 9, len(ln)))) }
		if has_prefix(ln, "when:") { sk.when = trim(substr(ln, 5, len(ln))) }
		if has_prefix(ln, "triggers:") { trg = split(trim(substr(ln, 9, len(ln))), " ") }
		i = i + 1
	}
	sk.triggers = trg
	return
}

func load_skills(dir) {
	files := list_dir(dir)
	s := []Skill{}
	i := 0
	while i < len(files) {
		if has_suffix(files[i], ".skill") {
			c := read_file(dir + "/" + files[i])
			if len(c) > 0 { s = append(s, parse_skill(c)) }
		}
		i = i + 1
	}
	skills = s
}

// score a skill against lowercased request text: +priority-weighted per trigger hit
func skill_score(sk, low) (sc) {
	sc = 0
	i := 0
	while i < len(sk.triggers) {
		t := sk.triggers[i]
		if len(t) > 0 && contains(low, t) { sc = sc + 1 }
		i = i + 1
	}
	return
}

// select the top matched skills for a request; returns their concatenated bodies.
// ctx gates by context: skills declaring when:tools need tools_present, when:
// tool_result need a prior tool-result turn.
func match_skills(usertext, tools_present, tool_result_present) (out) {
	out = ""
	if len(skills) == 0 { return }
	low := to_lower(usertext)
	// score all, pick top skills_max with score>0 (priority breaks ties)
	picked := []int{}
	used := make(map[int]int)
	k := 0
	while k < skills_max {
		best := -1
		bestv := 0
		i := 0
		while i < len(skills) {
			eligible := 1
			if skills[i].when == "tools" && tools_present == false { eligible = 0 }
			if skills[i].when == "tool_result" && tool_result_present == false { eligible = 0 }
			if has(used, i) == false && eligible == 1 {
				sc := skill_score(skills[i], low) * 1000 + skills[i].priority
				hit := skill_score(skills[i], low)
				if hit > 0 && sc > bestv { bestv = sc  best = i }
			}
			i = i + 1
		}
		if best < 0 { break }
		used[best] = 1
		picked = append(picked, best)
		k = k + 1
	}
	i := 0
	while i < len(picked) {
		out = out + "\n\n## Skill: " + skills[picked[i]].name + "\n" + skills[picked[i]].body + "\n"
		i = i + 1
	}
	return
}

func mutex_srv(acq, rel) {
	while true {
		acq <- 1
		v := <-rel
		if v < 0 { break }
	}
}

// Prometheus-style metrics. IMPORTANT: request-handler strings live in a
// per-request arena that is recycled — never store request-built strings in
// globals (that corrupted the registry and segfaulted). Store NUMBERS only;
// label strings are composed at scrape time from startup-stable names
// (edomains, ep_names).
func met_ep(ix) {
	met_acq <- 1
	ep_counts[ix] = ep_counts[ix] + 1
	met_rel <- 1
}

func lane_ix(expert) (ix) {
	ix = 0
	while ix < len(edomains) { if edomains[ix] == expert { return }  ix = ix + 1 }
	ix = len(edomains) // "default"/unmatched bucket
	return
}

func handle_metrics() (res) {
	met_acq <- 1
	out := "anvil_requests_total{ep=\"route\",action=\"tool_call\"} " + str(rt_tc) + "\n"
	out = out + "anvil_requests_total{ep=\"route\",action=\"delegate\"} " + str(rt_del) + "\n"
	out = out + "anvil_decision_latency_ms_sum{ep=\"route\"} " + str(rt_lat_sum) + "\n"
	out = out + "anvil_decision_latency_ms_count{ep=\"route\"} " + str(rt_lat_cnt) + "\n"
	i := 0
	while i < len(lane_names_out) {
		l := lane_names_out[i]
		out = out + "anvil_lane_requests_total{expert=\"" + l + "\"} " + str(lane_req[i]) + "\n"
		out = out + "anvil_delegates_total{expert=\"" + l + "\"} " + str(lane_del[i]) + "\n"
		if lane_ss_cnt[i] > 0 {
			out = out + "anvil_set_size_sum{lane=\"" + l + "\"} " + str(lane_ss_sum[i]) + "\n"
			out = out + "anvil_set_size_count{lane=\"" + l + "\"} " + str(lane_ss_cnt[i]) + "\n"
		}
		i = i + 1
	}
	j := 0
	while j < len(ep_names) { out = out + "anvil_http_requests_total{ep=\"" + ep_names[j] + "\"} " + str(ep_counts[j]) + "\n"  j = j + 1 }
	met_rel <- 1
	out = out + "anvil_uptime_seconds " + str((now_ms() - boot_ms) / 1000) + "\n"
	res = response("200 OK", "text/plain; version=0.0.4", out)
	return
}

// llama3 chat template at the TOKEN level:
// <|begin_of_text|>(<|start_header_id|>{role}<|end_header_id|>\n\n{content}<|eot_id|>)*<|start_header_id|>assistant<|end_header_id|>\n\n
func l3_chat_tokens(msgs) (toks) {
	toks = []int{}
	toks = append(toks, 128000)
	i := 0
	while i < len(msgs) {
		m := msgs[i]
		toks = append(toks, 128006)
		seg := l3_encode(m.role)
		j := 0
		while j < len(seg) { toks = append(toks, seg[j])  j = j + 1 }
		toks = append(toks, 128007)
		seg = l3_encode("\n\n" + m.content)
		j = 0
		while j < len(seg) { toks = append(toks, seg[j])  j = j + 1 }
		toks = append(toks, 128009)
		i = i + 1
	}
	toks = append(toks, 128006)
	seg := l3_encode("assistant")
	i = 0
	while i < len(seg) { toks = append(toks, seg[i])  i = i + 1 }
	toks = append(toks, 128007)
	seg = l3_encode("\n\n")
	i = 0
	while i < len(seg) { toks = append(toks, seg[i])  i = i + 1 }
	return
}

// Zephyr chat template at the TOKEN level: "</s>" must be the real EOS id (2),
// not the text "</s>" run through BPE (they tokenize differently).
func chat_tokens(msgs) (toks) {
	if tok_l3 == 1 {
		toks = l3_chat_tokens(msgs)
		return
	}
	toks = []int{}
	toks = append(toks, 1) // BOS
	i := 0
	while i < len(msgs) {
		m := msgs[i]
		seg := bpe_encode_raw("<|" + m.role + "|>\n" + m.content)
		j := 0
		while j < len(seg) { toks = append(toks, seg[j])  j = j + 1 }
		toks = append(toks, 2) // EOS closes each turn
		nl := bpe_encode_raw("\n")
		j = 0
		while j < len(nl) { toks = append(toks, nl[j])  j = j + 1 }
		i = i + 1
	}
	tail := bpe_encode_raw("<|assistant|>\n")
	i = 0
	while i < len(tail) { toks = append(toks, tail[i])  i = i + 1 }
	return
}

// strip surrounding double-quotes from a json_get scalar token
func unq(s) (o) {
	o = s
	if len(s) >= 2 && has_prefix(s, "\"") && has_suffix(s, "\"") { o = substr(s, 1, len(s)-1) }
	return
}

// extract the balanced-brace JSON object that contains the first occurrence of
// `anchor` (e.g. "\"tool_call\""); "" if not found. Skips prose/code-fence wrap.
func extract_obj(s, anchor) (o) {
	o = ""
	a := index(s, anchor)
	if a < 0 { return }
	// back up to the enclosing '{'
	st := a
	while st >= 0 && charat(s, st) != "{" { st = st - 1 }
	if st < 0 { return }
	depth := 0
	i := st
	instr := 0
	esc := 0
	while i < len(s) {
		c := charat(s, i)
		if esc == 1 { esc = 0  i = i + 1  continue }
		if c == "\\" && instr == 1 { esc = 1  i = i + 1  continue }
		if c == "\"" { if instr == 1 { instr = 0 } else { instr = 1 } }
		if instr == 0 {
			if c == "{" { depth = depth + 1 }
			if c == "}" { depth = depth - 1  if depth == 0 { o = substr(s, st, i+1)  return } }
		}
		i = i + 1
	}
	return
}

// build the tool-instruction text appended to the system prompt
func tools_prompt(tools, body) (s) {
	s = "\n\n# Tools\nYou can call a function. Available functions:\n"
	i := 0
	while i < len(tools) {
		params, _ := json_get(body, ".tools[" + str(i) + "].function.parameters")
		if len(params) == 0 { params = "{}" }
		s = s + "- " + tools[i].function.name + ": " + tools[i].function.description + " | parameters JSON schema: " + params + "\n"
		i = i + 1
	}
	s = s + "\nWhen you need a function, reply with ONLY this exact JSON shape on one line and nothing else — no prose, no code fence:\n"
	s = s + "{\"tool_call\": {\"name\": \"FUNCTION_NAME\", \"arguments\": {ARG_KEY: ARG_VALUE}}}\n"
	s = s + "Example: {\"tool_call\": {\"name\": \"bash\", \"arguments\": {\"command\": \"ls -la\"}}}\n"
	s = s + "The value of \"name\" MUST be one of the function names above, and \"arguments\" MUST be a JSON object.\n"
	s = s + "After you receive the tool result (a message with role tool), answer the user in plain text. If no function is needed, just answer in plain text.\n"
	return
}

// normalize messages for templating: inject tools into system prompt, render
// prior assistant tool_calls as their JSON, and tool-result messages as user
// observations (roles collapse to system/user/assistant for the chat template).
func prep_messages(cr) (out) {
	out = []ChatMsg{}
	inject := ""
	// skills: match on the last user message, inject guidance BEFORE tool schema
	last_user := ""
	ui := len(cr.messages) - 1
	while ui >= 0 {
		if cr.messages[ui].role == "user" { last_user = cr.messages[ui].content  break }
		ui = ui - 1
	}
	tres := 0
	ti := 0
	while ti < len(cr.messages) {
		if cr.messages[ti].role == "tool" { tres = 1  break }
		ti = ti + 1
	}
	sk := match_skills(last_user, len(cr.tools) > 0, tres == 1)
	if len(sk) > 0 { inject = inject + sk }
	// ANVIL_TOOLS_INJECT=0: do not paste the tool schemas into the system prompt. For a model whose
	// tools are baked in by fine-tuning (MTLM), the schema text would only burn context; tool_calls in
	// the OUTPUT are still parsed and shaped as OpenAI tool_calls exactly as before.
	if len(cr.tools) > 0 && env("ANVIL_TOOLS_INJECT") != "0" { inject = inject + tools_prompt(cr.tools, cr.reqbody) }
	sys_done := 0
	i := 0
	while i < len(cr.messages) {
		m := cr.messages[i]
		if m.role == "system" {
			c := m.content
			if inject != "" && sys_done == 0 { c = c + inject  sys_done = 1 }
			out = append(out, ChatMsg{role: "system", content: c})
			i = i + 1
			continue
		}
		if m.role == "tool" {
			// ANVIL_TOOL_RESULT_MAX=<chars>: truncate long tool results (small-context models); keeps head+tail.
			trc := m.content
			mx := parse_int(env("ANVIL_TOOL_RESULT_MAX"))
			if mx > 40 && len(trc) > mx { trc = substr(trc, 0, mx - 24) + " ... " + substr(trc, len(trc) - 16, len(trc)) }
			out = append(out, ChatMsg{role: "user", content: "Tool result: " + trc})
			i = i + 1
			continue
		}
		if m.role == "assistant" && len(m.tool_calls) > 0 {
			tc := m.tool_calls[0]
			jc := "{\"tool_call\": {\"name\": \"" + tc.function.name + "\", \"arguments\": " + tc.function.arguments + "}}"
			out = append(out, ChatMsg{role: "assistant", content: jc})
			i = i + 1
			continue
		}
		out = append(out, ChatMsg{role: m.role, content: m.content})
		i = i + 1
	}
	// tools present but no system message yet -> prepend one
	if inject != "" && sys_done == 0 {
		pre := []ChatMsg{}
		pre = append(pre, ChatMsg{role: "system", content: "You are a helpful assistant." + inject})
		j := 0
		while j < len(out) { pre = append(pre, out[j])  j = j + 1 }
		out = pre
	}
	return
}

// first non-empty json_get among several candidate paths -> raw token ("" if none)
func jget_any(obj, paths) (v) {
	v = ""
	i := 0
	while i < len(paths) {
		r, e := json_get(obj, paths[i])
		if len(e) == 0 && len(r) > 0 && r != "null" { v = r  return }
		i = i + 1
	}
	return
}

// detect+parse a tool call in the model's raw output -> (name, arguments_json).
// name "" means no tool call. 1B models emit several near-formats; accept the
// common ones: {"tool_call":{"name","arguments"}}, {"tool_call":"name","arguments":{}},
// {"name","arguments"|"parameters"}, {"function":"name","arguments"}.
func parse_tool_call(text) (name, argsjson) {
	name = ""
	argsjson = "{}"
	obj := extract_obj(text, "\"tool_call\"")
	if len(obj) == 0 { obj = extract_obj(text, "\"name\"") }
	if len(obj) == 0 { obj = extract_obj(text, "\"function\"") }
	if len(obj) == 0 { return }
	nm := jget_any(obj, []string{".tool_call.name", ".tool_call", ".name", ".function", ".function.name"})
	if len(nm) == 0 { return }
	name = unq(nm)
	if len(name) == 0 || contains(name, "{") || contains(name, " ") { name = ""  return }
	a := jget_any(obj, []string{".tool_call.arguments", ".arguments", ".tool_call.parameters", ".parameters"})
	if len(a) > 0 {
		if has_prefix(a, "\"") { argsjson = "{}" } else { argsjson = a }
	}
	return
}

func json_esc(s) (o) {
	o = replace(s, "\\", "\\\\")
	o = replace(o, "\"", "\\\"")
	o = replace(o, "\n", "\\n")
	o = replace(o, "\r", "\\r")
	o = replace(o, "\t", "\\t")
	return
}

func chunk_json(id, created, piece, finish) (s) {
	d := "{\"content\":\"" + json_esc(piece) + "\"}"
	if len(piece) == 0 { d = "{}" }
	fr := "null"
	if len(finish) > 0 { fr = "\"" + finish + "\"" }
	s = "{\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":" + str(created) + ",\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":" + d + ",\"finish_reason\":" + fr + "}]}"
	return
}

func handle_models() (res) {
	body := "{\"object\":\"list\",\"data\":[{\"id\":\"" + model_id + "\",\"object\":\"model\",\"created\":0,\"owned_by\":\"machin-anvil\"}]}"
	res = ok_json(body)
	return
}

// GET /guide — cli-guide-spec: the embedded operator manual as JSON, so an
// agent that finds this binary serving on a port can learn the whole surface
// without external docs. Dynamic fields report what THIS instance loaded.
func handle_guide() (res) {
	g := "{\"name\":\"anvil-serve\",\"spec\":\"cli-guide-spec\",\"model\":\"" + model_id + "\","
	g = g + "\"overview\":\"OpenAI-compatible inference + typed decision heads on a frozen trunk. Heads are small linear classifiers over pooled hidden states (mhd1/mhd2/mhd3) scored in the same forward pass — decisions cost ~one prefill, no generation.\","
	g = g + "\"endpoints\":["
	g = g + "{\"method\":\"POST\",\"path\":\"/v1/route\",\"doc\":\"dispatcher: gate -> expert head -> noul/score -> optional execute. body: {state|messages, context[], expert?, options[], min_conf?, min_gate_conf?, execute?}\"},"
	g = g + "{\"method\":\"POST\",\"path\":\"/v1/decide\",\"doc\":\"route head only. body: {state|messages, context[]}\"},"
	g = g + "{\"method\":\"POST\",\"path\":\"/v1/noul\",\"doc\":\"escalation yes/no head\"},"
	g = g + "{\"method\":\"POST\",\"path\":\"/v1/score\",\"doc\":\"complexity tier 1-4\"},"
	g = g + "{\"method\":\"POST\",\"path\":\"/v1/assess\",\"doc\":\"decide+noul+score in one call\"},"
	g = g + "{\"method\":\"POST\",\"path\":\"/v1/systemone\",\"doc\":\"Jev-compatible typed questions: {state, model, questions:{qid:{type:noul|choice|score, instructions, criteria}}} -> {answers:{...}} — teacher-forced mean-logprob candidate scoring, no generation, no head files needed\"},"
	g = g + "{\"method\":\"POST\",\"path\":\"/v1/chat/completions\",\"doc\":\"generative path, OpenAI-compatible, SSE stream\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/v1/models\",\"doc\":\"model id\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/v1/whoami\",\"doc\":\"masked key identity + tenant head + expert lanes\"},"
	g = g + "{\"method\":\"POST\",\"path\":\"/v1/feedback\",\"doc\":\"open submit {message,kind?,context?,reporter?,id?} — idempotent on id, 16KB cap, 30/min/ip\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/v1/feedback\",\"doc\":\"admin-gated read (valid ANVIL_KEYS bearer), ?limit=n\"},"
	g = g + "{\"method\":\"POST\",\"path\":\"/_shutdown\",\"doc\":\"token-gated (or loopback-only without keys) shutdown\"},"
	g = g + "{\"method\":\"GET|POST\",\"path\":\"/_qhat\",\"doc\":\"live conformal recalibration — read or set per-lane qhat (ACI/flywheel hook), same gating as /_shutdown\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/health\",\"doc\":\"liveness (alias /_health)\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/livez\",\"doc\":\"k8s liveness — always 200 while serving\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/readyz\",\"doc\":\"k8s readiness — 503 until a head or expert lane is loaded\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/v1/lanes\",\"doc\":\"per-lane readiness: routes, qhat, minconf, gate\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/guide\",\"doc\":\"this document\"},"
	g = g + "{\"method\":\"GET\",\"path\":\"/llms.txt\",\"doc\":\"agent-facing plain-text summary\"}],"
	g = g + "\"loaded\":{\"routes\":" + str(def_head.nr) + ",\"experts\":" + str(len(edomains)) + ",\"gate_domains\":" + str(len(ghead.names)) + "},"
	g = g + "\"env\":[\"ANVIL_HEAD|NOUL|SCORE|GATE=<file.head>\",\"ANVIL_EXPERTS=dom:file.head,...\",\"ANVIL_EXPERT_MINCONF=dom:0.5,...\",\"ANVIL_EXPERT_QHAT=dom:0.648,... / ANVIL_CONFORMAL_QHAT (conformal gate, replaces minconf floor on the lane)\",\"ANVIL_ROUTE_MINCONF\",\"ANVIL_GATE_MINCONF\",\"ANVIL_KEYS=k1,k2\",\"ANVIL_TENANTS=key:file.head,...\",\"ANVIL_LOG=decisions.jsonl\",\"ANVIL_FEEDBACK_LOG=feedback.jsonl\",\"ANVIL_DELEGATE_URL|KEY|MODEL|SYS\",\"ANVIL_POOL=max|mean (legacy override)\",\"ANVIL_S1_T[_CHOICE|_NOUL|_SCORE] (systemone candidate softmax temps, default 1.0)\",\"COLIBRI_THREADS\",\"COLIBRI_NOBATCH=1\"],"
	g = g + "\"gotchas\":[\"expert pin skips gate AND noul/score — the expert's own 'escalate' class is its abstention path\",\"pooled heads reject prompts >context with 400\",\"kind-0 'last' taps are the final-layer snapshot only\",\"per-request min_conf beats every env floor\"],"
	g = g + "\"delegation\":\"action=delegate + reason: low_confidence|low_gate_confidence|route_escalate|noul_escalate|conformal_abstain|head_trunk_disagree — a confident answer requires head AND trunk to agree when execute:true\"}"
	res = ok_json(g)
	return
}

// GET /llms.txt — one-screen plain-text summary for agents.
func handle_llms() (res) {
	t := "anvil-serve (machin-anvil) — typed decision layer + OpenAI-compatible inference, pure MFL.\n"
	t = t + "POST /v1/route {state} -> {action: tool_call|delegate|generate, route, confidence, domain, expert}\n"
	t = t + "POST /v1/decide|noul|score|assess — individual heads. POST /v1/chat/completions — generative.\n"
	t = t + "GET /guide for the full JSON manual, /health for liveness. Expert pin: body.expert=<domain>.\n"
	t = t + "Delegation is a feature: low conf, escalate route, noul veto, or head/trunk disagreement all return action=delegate — route to a bigger model or human, never guess.\n"
	res = ok_text(t)
	return
}

func delayed_exit() { sleep(200)  exit(0) }

// POST /_shutdown — cli-daemon-spec: shutdown is token-gated whenever the
// bind isn't loopback. We always bind 0.0.0.0 (appliance), so: when
// ANVIL_KEYS is set a valid bearer is required; with no keys, loopback
// peers only. The exit is deferred so this response reaches the caller.
func handle_shutdown(req) (res) {
	if len(api_keys) > 0 {
		if auth_ok(req) == 0 {
			res = ok_json("{\"error\":{\"message\":\"invalid api key\",\"type\":\"invalid_request_error\"}}")
			res.status = "401 Unauthorized"
			return
		}
	} else {
		if req.remote != "127.0.0.1" && req.remote != "::1" {
			res = ok_json("{\"error\":{\"message\":\"shutdown is loopback-only without ANVIL_KEYS\",\"type\":\"forbidden\"}}")
			res.status = "403 Forbidden"
			return
		}
	}
	res = ok_json("{\"ok\":true,\"stopping\":true,\"shutting_down\":true}")
	go delayed_exit()
	return
}

// GET/POST /_qhat — live conformal recalibration. Same gating as /_shutdown.
// POST {"expert":"mairie_c","qhat":0.62} sets a lane's qhat (append or update);
// {"expert":"default",...} sets the global one. This is the hook an external
// ACI loop (flywheel: score feedback labels -> adjust qhat) pushes through —
// the guarantee survives drift because the threshold can move at runtime.
func handle_qhat(req) (res) {
	if len(api_keys) > 0 {
		if auth_ok(req) == 0 {
			res = ok_json("{\"error\":{\"message\":\"invalid api key\",\"type\":\"invalid_request_error\"}}")
			res.status = "401 Unauthorized"
			return
		}
	} else {
		if req.remote != "127.0.0.1" && req.remote != "::1" {
			res = ok_json("{\"error\":{\"message\":\"qhat admin is loopback-only without ANVIL_KEYS\",\"type\":\"forbidden\"}}")
			res.status = "403 Forbidden"
			return
		}
	}
	if req.method == "GET" {
		b := "{\"ok\":true,\"default\":" + str(conf_qhat) + ",\"experts\":{"
		i := 0
		while i < len(cq_names) {
			if i > 0 { b = b + "," }
			b = b + "\"" + json_esc(cq_names[i]) + "\":" + str(cq_vals[i])
			i = i + 1
		}
		res = ok_json(b + "}}")
		return
	}
	raw, _ := json_get(req.body, ".expert")
	ex := unq(raw)
	qraw, qerr := json_get(req.body, ".qhat")
	q := parse_float(unq(qraw))
	if len(qerr) > 0 || q <= 0.0 || q >= 1.0 {
		res = ok_json("{\"ok\":false,\"error\":\"qhat required, 0<qhat<1\"}")
		res.status = "400 Bad Request"
		return
	}
	if len(ex) == 0 || ex == "default" {
		conf_qhat = q
		res = ok_json("{\"ok\":true,\"expert\":\"default\",\"qhat\":" + str(q) + "}")
		return
	}
	i := 0
	while i < len(cq_names) {
		if cq_names[i] == ex {
			cq_vals[i] = q
			res = ok_json("{\"ok\":true,\"expert\":\"" + json_esc(ex) + "\",\"qhat\":" + str(q) + "}")
			return
		}
		i = i + 1
	}
	cq_names = append(cq_names, ex)  cq_vals = append(cq_vals, q)
	res = ok_json("{\"ok\":true,\"expert\":\"" + json_esc(ex) + "\",\"qhat\":" + str(q) + "}")
	return
}

// GET /v1/whoami — cli-trial-spec: a bearer tells the agent which identity
// and head it lands on, without exposing the key itself.
func handle_whoami(req) (res) {
	k := bearer_key(req)
	mask := "none"
	if len(k) > 8 { mask = substr(k, 0, 6) + "…" + substr(k, len(k) - 4, len(k)) } else if len(k) > 0 { mask = "***" }
	tn := "default"
	i := 0
	while i < len(tkeys) { if tkeys[i] == k { tn = "tenant:" + str(i) }  i = i + 1 }
	exp := "["
	i = 0
	while i < len(edomains) {
		if i > 0 { exp = exp + "," }
		exp = exp + "\"" + json_esc(edomains[i]) + "\""
		i = i + 1
	}
	exp = exp + "]"
	res = ok_json("{\"model\":\"" + model_id + "\",\"key\":\"" + mask + "\",\"head\":\"" + tn + "\",\"experts\":" + exp + "}")
	return
}

func handle_ready() (res) {
	// KServe-style readiness: 200 only when at least one decision surface is
	// loaded (default head or an expert). /livez stays unconditional.
	n_lanes := len(edomains)
	if hd_nr == 0 && n_lanes == 0 {
		res = ok_json("{\"ready\":false,\"reason\":\"no decision head or expert loaded\"}")
		res.status = "503 Service Unavailable"
		return
	}
	res = ok_json("{\"ready\":true,\"model\":\"" + model_id + "\",\"head_routes\":" + str(hd_nr) + ",\"experts\":" + str(n_lanes) + ",\"gate_domains\":" + str(ghead.nr) + "}")
	return
}

func handle_lanes() (res) {
	// Per-lane readiness detail: names, class counts, calibration state.
	// All names are startup-stable strings (never request-arena).
	b := "{\"model\":\"" + model_id + "\",\"default\":{\"routes\":" + str(hd_nr)
	if conf_qhat > 0.0 { b = b + ",\"qhat\":" + str(conf_qhat) }
	b = b + "},\"lanes\":["
	i := 0
	while i < len(edomains) {
		if i > 0 { b = b + "," }
		b = b + "{\"name\":\"" + json_esc(edomains[i]) + "\",\"routes\":" + str(eheads[i].nr)
		j := 0
		while j < len(cq_names) { if cq_names[j] == edomains[i] { b = b + ",\"qhat\":" + str(cq_vals[j]) }  j = j + 1 }
		j = 0
		while j < len(emin_names) { if emin_names[j] == edomains[i] { b = b + ",\"minconf\":" + str(emin_vals[j]) }  j = j + 1 }
		b = b + "}"
		i = i + 1
	}
	b = b + "]"
	if ghead.nr > 0 { b = b + ",\"gate\":{\"domains\":" + str(ghead.nr) + ",\"minconf\":" + str(gate_minconf) + "}" }
	res = ok_json(b + "}")
	return
}

func parse_chat_req(body) (cr, err) {
	err = ""
	cr = parse(body, ChatReq{})
	cr.reqbody = body
	if len(cr.messages) == 0 { err = "messages required" }
	if cr.max_tokens <= 0 { cr.max_tokens = 256 }
	if cr.temperature < 0.0 { cr.temperature = 0.0 }
	if cr.top_p <= 0.0 || cr.top_p > 1.0 { cr.top_p = 0.9 }
	return
}

// one tool_call as an OpenAI object fragment (arguments is a JSON string)
func tc_obj(callid, name, argsjson) (s) {
	s = "{\"id\":\"" + callid + "\",\"type\":\"function\",\"function\":{\"name\":\"" + json_esc(name) + "\",\"arguments\":\"" + json_esc(argsjson) + "\"}}"
	return
}

func usage_json(np, n, reused) (s) {
	s = "\"usage\":{\"prompt_tokens\":" + str(np) + ",\"completion_tokens\":" + str(n) + ",\"total_tokens\":" + str(np + n) + ",\"prompt_tokens_cached\":" + str(reused) + "}"
	return
}

func handle_chat(req) (res) {
	cr, perr := parse_chat_req(req.body)
	if len(perr) > 0 {
		res = ok_json("{\"error\":{\"message\":\"" + json_esc(perr) + "\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	id := "chatcmpl-" + to_hex(rand_bytes(8))
	created := now()
	msgs := prep_messages(cr)
	toks := chat_tokens(msgs)
	if len(toks) >= seq_len {
		res = ok_json("{\"error\":{\"message\":\"prompt exceeds model context length\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	has_tools := len(cr.tools) > 0

	// live token streaming (no tools: we don't need to inspect the whole output)
	if cr.stream && has_tools == false {
		res = sse(func(conn) {
			lk := <-mu_acq
			lk = lk
			if cr.seed > 0 { rng_seed(cr.seed) } else { rng_seed(now_ms() & 2147483647) }
			write(conn, "data: " + chunk_json(id, created, "", "") + "\n\n")
			generate_cb(toks, cr.max_tokens, cr.temperature, cr.top_p, func(piece) {
				write(conn, "data: " + chunk_json(id, created, piece, "") + "\n\n")
			})
			write(conn, "data: " + chunk_json(id, created, "", "stop") + "\n\n")
			write(conn, "data: [DONE]\n\n")
			mu_rel <- 1
		})
		return
	}

	// buffered path (non-stream, or stream+tools: we must see the full output to
	// decide content-vs-tool_call before shaping the response)
	lk := <-mu_acq
	lk = lk
	if cr.seed > 0 { rng_seed(cr.seed) } else { rng_seed(now_ms() & 2147483647) }
	out := []string{}
	n := generate_cb(toks, cr.max_tokens, cr.temperature, cr.top_p, func(piece) {
		out = append(out, piece)
	})
	reused := gen_prefill_reused
	mu_rel <- 1
	full := join(out, "")
	tname := ""
	targs := "{}"
	if has_tools { tname, targs = parse_tool_call(full) }
	callid := "call_" + to_hex(rand_bytes(6))
	np := len(toks)

	if cr.stream {
		tcinner := "{\"index\":0,\"id\":\"" + callid + "\",\"type\":\"function\",\"function\":{\"name\":\"" + json_esc(tname) + "\",\"arguments\":\"" + json_esc(targs) + "\"}}"
		res = sse(func(conn) {
			write(conn, "data: " + chunk_json(id, created, "", "") + "\n\n")
			if len(tname) > 0 {
				write(conn, "data: {\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":" + str(created) + ",\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[" + tcinner + "]},\"finish_reason\":\"tool_calls\"}]}\n\n")
			} else {
				write(conn, "data: " + chunk_json(id, created, full, "") + "\n\n")
				write(conn, "data: " + chunk_json(id, created, "", "stop") + "\n\n")
			}
			write(conn, "data: [DONE]\n\n")
		})
		return
	}

	if len(tname) > 0 {
		body := "{\"id\":\"" + id + "\",\"object\":\"chat.completion\",\"created\":" + str(created) + ",\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":null,\"tool_calls\":[" + tc_obj(callid, tname, targs) + "]},\"finish_reason\":\"tool_calls\"}]," + usage_json(np, n, reused) + "}"
		res = ok_json(body)
		return
	}
	body := "{\"id\":\"" + id + "\",\"object\":\"chat.completion\",\"created\":" + str(created) + ",\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"" + json_esc(full) + "\"},\"finish_reason\":\"stop\"}]," + usage_json(np, n, reused) + "}"
	res = ok_json(body)
	return
}

type DecideReq struct {
	state string
	options []string
	context []string
}

// system prompt the route head was trained under (synth_tools SYSTEM).
var decide_sys = "You are a helpful assistant. You can call tools. When a tool is needed, reply with only the JSON tool call. Otherwise answer in plain English."

// decision logging: ANVIL_LOG=<path> appends one JSONL row per decide/noul
// call — the raw material for real-traffic calibration (bucket conf vs
// outcome later; outcomes arrive when downstream reports them).
var decide_log = ""

// delegation upstream: when /v1/route delegates and execute=true, the request
// is forwarded here (OpenAI-compatible /v1/chat/completions endpoint) and the
// upstream answer rides back in "content" with "via" naming the upstream.
// ANVIL_DELEGATE_URL / ANVIL_DELEGATE_KEY / ANVIL_DELEGATE_MODEL — unset =
// delegate stays a caller-handled decision, no forwarding.
var delegate_url = ""
var delegate_key = ""
var delegate_model = ""
var delegate_sys = ""

// auth + tenancy: ANVIL_KEYS="k1,k2" gates all /v1/* behind Bearer auth
// (/health stays open). ANVIL_TENANTS="k1:headA.head,k2:headB.head" maps a
// key to its own decision head — swapped in per request under the model
// lock. Unknown/unkeyed requests get the ANVIL_HEAD default.
var api_keys = []string{}
var tkeys = []string{}
var thead = []Head{}   // parallel to tkeys: tenant heads preloaded at startup
var def_head = zero_head()

func zero_head() (h) {
	h = Head{}
	return
}

// MoE gate: ANVIL_GATE=<gate.head> turns /v1/route into a two-stage
// dispatcher. The gate head scores the DOMAIN on the same prefill hidden
// state, then the matching ANVIL_EXPERTS="dom:head.head,..." head scores the
// routes — one forward pass, two decisions. gate_conf below
// ANVIL_GATE_MINCONF (or the request's min_gate_conf) delegates with reason
// low_gate_confidence; a domain with no expert mapping falls back to the
// ANVIL_HEAD default.
var ghead = zero_head()
var edomains = []string{}
var eheads = []Head{}      // parallel to edomains
var emin_names = []string{} // ANVIL_EXPERT_MINCONF="mairie:0.30,..." — per-lane
var emin_vals = []float{}   //   confidence floor; overrides the global floor
var cq_names = []string{}   // ANVIL_EXPERT_QHAT="mairie_c:0.648,..." — per-lane
var cq_vals = []float{}     //   conformal qhat (set = {p >= 1-qhat}); 0=off
var conf_qhat = 0.0         // ANVIL_CONFORMAL_QHAT — global qhat for the default head
var s1_t_choice = 1.0       // ANVIL_S1_T_* — /v1/systemone candidate softmax temps
var s1_t_noul = 1.0
var s1_t_score = 1.0
var s1_chat = 0             // ANVIL_S1_CHAT=1 — wrap prefix as a user turn (helps chat-tuned trunks)
var s1_cand_desc = 0        // ANVIL_S1_CAND=desc — score criteria descriptions instead of bare keys
var s1_first_tok = 0        // ANVIL_S1_FIRSTTOK=1 — first-token logprob only (mean dilutes short labels)
var s1_head = Head{}        // ANVIL_S1_HEAD — trained entailment head scores candidates (USLP-style)
var s1_yes = -1
var gate_minconf = 0.0

func bearer_key(req) (k) {
	k = ""
	a := trim(header(req, "authorization"))
	if has_prefix(a, "Bearer ") { k = trim(substr(a, 7, len(a))) }
	return
}

func auth_ok(req) (ok) {
	ok = 1
	if len(api_keys) > 0 {
		ok = 0
		k := bearer_key(req)
		i := 0
		while i < len(api_keys) { if api_keys[i] == k { ok = 1 }  i = i + 1 }
	}
	return
}

// swap in the tenant's head if the caller's key is mapped; must be called
// while the model lock is held (after head_prefill, before decide).
func apply_tenant_head(req) {
	if len(tkeys) == 0 { return }
	k := bearer_key(req)
	i := 0
	while i < len(tkeys) {
		if tkeys[i] == k { set_head(thead[i])  return }
		i = i + 1
	}
	set_head(def_head)
	return
}

type UpMsg struct {
	role string
	content string
}
type UpChoice struct {
	message UpMsg
}
type UpResp struct {
	choices []UpChoice
}

func log_decision(line) {
	if len(decide_log) == 0 { return }
	off := file_size(decide_log)
	if off < 0 { off = 0 }
	write_file_at(decide_log, off, bytes(line + "\n"))
	return
}

// head_prefill: render state as system+user chat, prefill, leave the normalized
// hidden in s_x. Returns 1 ok / 0 too-long. On ok the caller HOLDS the model
// lock — score the head, then mu_rel <- 1.
func head_prefill(state, ctx) (ok) {
	lk := <-mu_acq
	lk = lk
	ok = head_prefill_locked(state, ctx)
	if ok == 0 { mu_rel <- 1 }
	return
}

// head_prefill without lock acquisition — for callers already holding
// mu_acq (e.g. /v1/systemone's per-candidate scoring loop).
func head_prefill_locked(state, ctx) (ok) {
	ok = 0
	msgs := []ChatMsg{}
	m1 := ChatMsg{}  m1.role = "system"  m1.content = decide_sys
	msgs = append(msgs, m1)
	// optional prior turns: ctx is alternating user/assistant text, oldest first
	i := 0
	while i < len(ctx) {
		cm := ChatMsg{}
		if i % 2 == 0 { cm.role = "user" } else { cm.role = "assistant" }
		cm.content = ctx[i]
		msgs = append(msgs, cm)
		i = i + 1
	}
	m2 := ChatMsg{}  m2.role = "user"  m2.content = state
	msgs = append(msgs, m2)
	toks := chat_tokens(msgs)
	if len(toks) >= seq_len { return }
	np := len(toks)
	if len(pt_kinds) > 0 {
		// pooled heads read a max/mean over the last user turn's token span —
		// every position must be forwarded (no batch prefill, no prefix-cache
		// reuse or earlier span positions would go untapped). s_x keeps the
		// last-token hidden; each tap accumulates its own buffer.
		tail_len := len(chat_tokens([]ChatMsg{})) - 1
		pmsgs := []ChatMsg{}
		i := 0
		while i < len(msgs) - 1 { pmsgs = append(pmsgs, msgs[i])  i = i + 1 }
		pstart := len(chat_tokens(pmsgs)) - tail_len
		pend := np - tail_len
		pt_reset()
		// post-final-layer taps (layer >= n_layers) can't come from pb_x rows
		// in the batched path — fall back to the sequential loop for those.
		has_post := 0
		k := 0
		while k < len(pt_layers) { if pt_layers[k] >= n_layers { has_post = 1 }  k = k + 1 }
		// prefix-cache reuse is safe only up to the pooled span: every
		// position in [pstart, pend) must be (re)forwarded or tap features
		// go stale. Clamp the reuse boundary at pstart.
		start := cache_common(toks)
		if start > pstart { start = pstart }
		if start >= np { start = np - 1 }
		if has_post == 0 && np - start >= 16 && quant4 == 0 && pb_enabled == 1 {
			pb_pool = 1  pb_ps = pstart  pb_pe = pend
			head_prefill_batch(toks, start, np)
			pb_pool = 0
		} else {
			i = start
			while i < np {
				if i >= pstart && i < pend {
					pool_active = 1
					forward(toks[i], i)
					pool_active = 0
					k = 0
					while k < len(pt_layers) {
						if pt_layers[k] >= n_layers { pt_acc(k) }
						k = k + 1
					}
				} else {
					forward(toks[i], i)
				}
				i = i + 1
			}
			i = 0
			while i < dim { poke_f32(s_xlast, i*4, peek_f32(s_x, i*4))  i = i + 1 }
		}
		pt_finish()
	} else {
		start := cache_common(toks)
		if start >= np { start = np - 1 }
		if np - start >= 16 && quant4 == 0 && pb_enabled == 1 {
			prefill_batch(toks, start, np)
		} else {
			i := start
			while i < np { forward(toks[i], i)  i = i + 1 }
		}
		// ensure s_x holds the normalized hidden at the last prompt position
		// (the batched prefill leaves it in pb_* buffers, not s_x)
		forward(toks[np-1], np-1)
		// mhd3 heads can mix pooled taps with a last-token tap (kind 0)
		i = 0
		while i < dim { poke_f32(s_xlast, i*4, peek_f32(s_x, i*4))  i = i + 1 }
	}
	i = 0
	while i < np { poke_i32(cache_buf, i*4, toks[i])  i = i + 1 }
	cache_len = np
	ok = 1
	return
}

// POST /v1/noul {"state": "<text>"} — Jev-style yes/no: p(yes) from the noul
// head (a 2-route mhd1 with a "yes" label). The question is fixed at training
// time; this primitive answers "should this escalate?" for the router.
func handle_noul(req) (res) {
	if nl_head.nr == 0 {
		res = ok_json("{\"error\":{\"message\":\"no noul head loaded (set ANVIL_NOUL)\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	dr := parse(req.body, DecideReq{})
	if len(dr.state) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state required\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	if head_prefill(dr.state, dr.context) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state exceeds model context length\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	head_best(nl_head)
	mu_rel <- 1
	py := 0.0
	if nl_yes >= 0 { py = peek_f32(nl_head.probs, nl_yes*4) }
	ans := "no"
	if py >= 0.5 { ans = "yes" }
	body := "{\"object\":\"noul\",\"model\":\"" + model_id + "\",\"answer\":\"" + ans + "\",\"probability\":" + str(py) + "}"
	res = ok_json(body)
	log_decision("{\"ts\":" + str(now_ms()) + ",\"ep\":\"noul\",\"state\":\"" + json_esc(dr.state) + "\",\"answer\":\"" + ans + "\",\"p_yes\":" + str(py) + "}")
	return
}

// POST /v1/score {"state": "<text>"} — Jev-style rubric grade: distribution
// over the head's ordinal labels + the argmax as "grade". The rubric is fixed
// at training time — currently request complexity 1..4.
func handle_score(req) (res) {
	if sc_head.nr == 0 {
		res = ok_json("{\"error\":{\"message\":\"no score head loaded (set ANVIL_SCORE)\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	dr := parse(req.body, DecideReq{})
	if len(dr.state) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state required\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	if head_prefill(dr.state, dr.context) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state exceeds model context length\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	best := head_best(sc_head)
	mu_rel <- 1
	probs := ""
	i := 0
	while i < sc_head.nr {
		if i > 0 { probs = probs + "," }
		probs = probs + "\"" + json_esc(sc_head.names[i]) + "\":" + str(peek_f32(sc_head.probs, i*4))
		i = i + 1
	}
	body := "{\"object\":\"score\",\"model\":\"" + model_id + "\",\"grade\":\"" + json_esc(sc_head.names[best]) + "\",\"confidence\":" + str(peek_f32(sc_head.probs, best*4)) + ",\"probabilities\":{" + probs + "}}"
	res = ok_json(body)
	log_decision("{\"ts\":" + str(now_ms()) + ",\"ep\":\"score\",\"state\":\"" + json_esc(dr.state) + "\",\"grade\":\"" + json_esc(sc_head.names[best]) + "\",\"conf\":" + str(peek_f32(sc_head.probs, best*4)) + "}")
	return
}

// POST /v1/decide {"state": "<text>", "options": ["route", ...]?} — Jev-style
// typed decision: one prefill pass, head scores s_x, no tokens generated.
func handle_decide(req) (res) {
	if hd_nr == 0 {
		res = ok_json("{\"error\":{\"message\":\"no decision head loaded (set ANVIL_HEAD)\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	dr := parse(req.body, DecideReq{})
	if len(dr.state) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state required\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	if head_prefill(dr.state, dr.context) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state exceeds model context length\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	apply_tenant_head(req)
	best := decide()
	// optional subset restriction: zero out unlisted routes, renormalize
	if len(dr.options) > 0 {
		keep := alloc(hd_nr * 4)
		i := 0
		while i < hd_nr { poke_f32(keep, i*4, 0.0)  i = i + 1 }
		i = 0
		while i < len(dr.options) {
			j := 0
			while j < hd_nr { if hd_names[j] == dr.options[i] { poke_f32(keep, j*4, 1.0) }  j = j + 1 }
			i = i + 1
		}
		sum := 0.0
		i = 0
		while i < hd_nr {
			if peek_f32(keep, i*4) < 0.5 { poke_f32(hd_probs, i*4, 0.0) }
			sum = sum + peek_f32(hd_probs, i*4)
			i = i + 1
		}
		if sum > 0.0 { i = 0  while i < hd_nr { poke_f32(hd_probs, i*4, peek_f32(hd_probs, i*4) / sum)  i = i + 1 } }
		free(keep)
		best = 0
		i = 1
		while i < hd_nr { if peek_f32(hd_probs, i*4) > peek_f32(hd_probs, best*4) { best = i }  i = i + 1 }
	}
	probs := ""
	i = 0
	while i < hd_nr {
		if i > 0 { probs = probs + "," }
		probs = probs + "\"" + json_esc(hd_names[i]) + "\":" + str(peek_f32(hd_probs, i*4))
		i = i + 1
	}
	body := "{\"object\":\"decision\",\"model\":\"" + model_id + "\",\"choice\":\"" + json_esc(hd_names[best]) + "\",\"confidence\":" + str(peek_f32(hd_probs, best*4)) + ",\"probabilities\":{" + probs + "}}"
	mu_rel <- 1
	res = ok_json(body)
	log_decision("{\"ts\":" + str(now_ms()) + ",\"ep\":\"decide\",\"state\":\"" + json_esc(dr.state) + "\",\"choice\":\"" + json_esc(hd_names[best]) + "\",\"conf\":" + str(peek_f32(hd_probs, best*4)) + "}")
	return
}

// POST /v1/route — THE dispatcher: one call in, one dispatch decision out.
//   {"state": "<text>"} or OpenAI-style {"messages": [...]} (last user msg =
//   state, earlier user/assistant texts = context). Options:
//     "execute": true   — after routing, actually run the dispatch under the
//                         model lock (tool_call JSON for tool routes, prose
//                         for chat). The head and the trunk must AGREE or the
//                         call delegates — the Jev agreement gate.
//     "options": [...]  — restrict to a route subset (same as /v1/decide)
//     "min_conf": f     — confidence floor (default ANVIL_ROUTE_MINCONF|0.55)
// Gates, in order: noul p(yes)>=0.5 -> delegate(noul_escalate);
// conf < min_conf -> delegate(low_confidence); route==escalate ->
// delegate(route_escalate); execute: head!=trunk -> delegate(disagree).
// Response: action = delegate | tool_call | generate (+ call/content when
// executed), with route, confidence, p_yes, tier, reason, latency_ms.
type RouteReq struct {
	state string
	options []string
	context []string
	messages []ChatMsg
	execute bool
	expert string
	min_conf float
	min_gate_conf float
	max_tokens int
}

func route_state(dr) (state, ctx) {
	state = dr.state
	ctx = dr.context
	if len(state) == 0 && len(dr.messages) > 0 {
		i := len(dr.messages) - 1
		while i >= 0 {
			if dr.messages[i].role == "user" { state = dr.messages[i].content  break }
			i = i - 1
		}
		ctx = []string{}
		j := 0
		while j < i {
			if dr.messages[j].role == "user" || dr.messages[j].role == "assistant" {
				ctx = append(ctx, dr.messages[j].content)
			}
			j = j + 1
		}
	}
	return
}

func handle_route(req) (res) {
	if hd_nr == 0 {
		res = ok_json("{\"error\":{\"message\":\"no decision head loaded (set ANVIL_HEAD)\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	t0 := now_ms()
	dr := parse(req.body, RouteReq{})
	state, ctx := route_state(dr)
	if len(state) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state or messages required\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	minconf := 0.55
	emc := parse_float(env("ANVIL_ROUTE_MINCONF"))
	if emc > 0.0 { minconf = emc }
	if dr.min_conf > 0.0 { minconf = dr.min_conf }
	if head_prefill(state, ctx) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state exceeds model context length\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	domain := ""
	gconf := 0.0
	expert := ""
	pinned := 0
	if len(dr.expert) > 0 {
		// expert pin: a known-domain client (e.g. a game embedding the rpg
		// head) names its lane and skips the gate — the gate's job is
		// classifying *mixed-domain* front-door traffic, not re-proving a
		// domain the caller already knows. Unknown pins are a 400, not a
		// silent fallthrough.
		if len(edomains) == 0 {
			res = ok_json("{\"error\":{\"message\":\"expert pin requires ANVIL_EXPERTS\",\"type\":\"invalid_request_error\"}}")
			res.status = "400 Bad Request"
			mu_rel <- 1
			return
		}
		i := 0
		while i < len(edomains) {
			if edomains[i] == dr.expert { set_head(eheads[i])  expert = dr.expert  domain = dr.expert  gconf = 1.0  pinned = 1 }
			i = i + 1
		}
		if pinned == 0 {
			res = ok_json("{\"error\":{\"message\":\"unknown expert: " + json_esc(dr.expert) + "\",\"type\":\"invalid_request_error\"}}")
			res.status = "400 Bad Request"
			mu_rel <- 1
			return
		}
	}
	if pinned == 0 && len(ghead.names) > 0 {
		// MoE gate: score the domain on the same prefill, then swap in the
		// expert head for that domain (ANVIL_HEAD default when unmapped).
		gb := head_best(ghead)
		domain = ghead.names[gb]
		gconf = peek_f32(ghead.probs, gb*4)
		gmc := gate_minconf
		if dr.min_gate_conf > 0.0 { gmc = dr.min_gate_conf }
		expert = "default"
		set_head(def_head)
		i := 0
		while i < len(edomains) {
			if edomains[i] == domain { set_head(eheads[i])  expert = domain }
			i = i + 1
		}
		if gconf < gmc {
			lat := now_ms() - t0
			body := "{\"object\":\"route\",\"model\":\"" + model_id + "\",\"action\":\"delegate\",\"route\":\"\",\"confidence\":0.0,\"p_yes\":0.0,\"reason\":\"low_gate_confidence\",\"domain\":\"" + json_esc(domain) + "\",\"gate_confidence\":" + str(gconf) + ",\"latency_ms\":" + str(lat) + "}"
			mu_rel <- 1
			res = ok_json(body)
			log_decision("{\"ts\":" + str(now_ms()) + ",\"ep\":\"route\",\"state\":\"" + json_esc(state) + "\",\"action\":\"delegate\",\"reason\":\"low_gate_confidence\",\"domain\":\"" + json_esc(domain) + "\",\"gate_conf\":" + str(gconf) + "}")
			return
		}
	} else if pinned == 0 {
		apply_tenant_head(req)
	}
	best := decide()
	// optional subset restriction: zero out unlisted routes, renormalize
	if len(dr.options) > 0 {
		keep := alloc(hd_nr * 4)
		i := 0
		while i < hd_nr { poke_f32(keep, i*4, 0.0)  i = i + 1 }
		i = 0
		while i < len(dr.options) {
			j := 0
			while j < hd_nr { if hd_names[j] == dr.options[i] { poke_f32(keep, j*4, 1.0) }  j = j + 1 }
			i = i + 1
		}
		sum := 0.0
		i = 0
		while i < hd_nr {
			if peek_f32(keep, i*4) < 0.5 { poke_f32(hd_probs, i*4, 0.0) }
			sum = sum + peek_f32(hd_probs, i*4)
			i = i + 1
		}
		if sum > 0.0 { i = 0  while i < hd_nr { poke_f32(hd_probs, i*4, peek_f32(hd_probs, i*4) / sum)  i = i + 1 } }
		free(keep)
		best = 0
		i = 1
		while i < hd_nr { if peek_f32(hd_probs, i*4) > peek_f32(hd_probs, best*4) { best = i }  i = i + 1 }
	}
	// per-expert confidence floor: a pinned/gated lane can carry its own
	// abstention point (a municipal head's citizens phrase loosely — its floor
	// is lower than the open-domain front door's). Request min_conf still wins.
	if dr.min_conf <= 0.0 && len(expert) > 0 && expert != "default" {
		i := 0
		while i < len(emin_names) {
			if emin_names[i] == expert { minconf = emin_vals[i] }
			i = i + 1
		}
	}
	py := 0.0
	if nl_head.nr > 0 && pinned == 0 {
		// noul/score are OOD checks for the open-domain front door. A pinned
		// request already declared its domain — the expert's own `escalate`
		// class is the abstention path, and noul (trained on general
		// traffic) would veto legitimate in-domain phrasing.
		head_best(nl_head)
		if nl_yes >= 0 { py = peek_f32(nl_head.probs, nl_yes*4) }
	}
	tier := ""
	if sc_head.nr > 0 && pinned == 0 {
		sb := head_best(sc_head)
		tier = sc_head.names[sb]
	}
	conf := peek_f32(hd_probs, best*4)
	route := hd_names[best]
	action := "generate"
	if route != "chat" { action = "tool_call" }
	reason := "ok"
	if py >= 0.5 { action = "delegate"  reason = "noul_escalate" }
	// conformal qhat resolves per expert lane, else the default head's global.
	set_size := -1
	qhat := conf_qhat
	if len(expert) > 0 && expert != "default" {
		i := 0
		while i < len(cq_names) {
			if cq_names[i] == expert { qhat = cq_vals[i] }
			i = i + 1
		}
	}
	// On a conformal lane the calibrated set replaces the hand-tuned floor.
	if action != "delegate" && qhat <= 0.0 && conf < minconf { action = "delegate"  reason = "low_confidence" }
	if action != "delegate" && route == "escalate" { action = "delegate"  reason = "route_escalate" }
	// conformal gate: prediction set = classes with p >= 1-qhat (qhat calibrated
	// offline by tools/conformal_eval.py). A singleton set means "only one
	// plausible route" — a sharper confidence signal than max-p alone. Any other
	// set size abstains.
	if qhat > 0.0 {
		thr := 1.0 - qhat
		set_size = 0
		i := 0
		while i < hd_nr {
			if peek_f32(hd_probs, i*4) >= thr { set_size = set_size + 1 }
			i = i + 1
		}
		if action != "delegate" && set_size != 1 { action = "delegate"  reason = "conformal_abstain" }
	}

	call_name := ""
	call_args := "{}"
	content := ""
	if dr.execute && action != "delegate" {
		// still holding the model lock from head_prefill; prompt tokens are
		// already in the prefix cache so generation starts ~free.
		mt := dr.max_tokens
		if mt <= 0 { mt = 128 }
		out := []string{}
		hp := []ChatMsg{}
		m1 := ChatMsg{}  m1.role = "system"  m1.content = decide_sys
		hp = append(hp, m1)
		i := 0
		while i < len(ctx) {
			cm := ChatMsg{}
			if i % 2 == 0 { cm.role = "user" } else { cm.role = "assistant" }
			cm.content = ctx[i]
			hp = append(hp, cm)
			i = i + 1
		}
		m2 := ChatMsg{}  m2.role = "user"  m2.content = state
		hp = append(hp, m2)
		toks := chat_tokens(hp)
		rng_seed(now_ms() & 2147483647)
		generate_cb(toks, mt, 0.0, 0.9, func(piece) {
			out = append(out, piece)
		})
		full := join(out, "")
		tname, targs := parse_tool_call(full)
		if len(tname) > 0 {
			if tname == route {
				call_name = tname  call_args = targs
			} else {
				action = "delegate"  reason = "head_trunk_disagree"
			}
		} else {
			if route == "chat" {
				content = full
			} else {
				action = "delegate"  reason = "head_trunk_disagree"
			}
		}
	}
	mu_rel <- 1
	via := ""
	if dr.execute && action == "delegate" && len(delegate_url) > 0 {
		// upstream handoff — after mu_rel so a slow upstream never holds the
		// model lock; the trunk is no longer needed.
		mb := ""
		if len(dr.messages) > 0 {
			i := 0
			while i < len(dr.messages) {
				if i > 0 { mb = mb + "," }
				mb = mb + "{\"role\":\"" + json_esc(dr.messages[i].role) + "\",\"content\":\"" + json_esc(dr.messages[i].content) + "\"}"
				i = i + 1
			}
		} else {
			// upstream is a general model — pass the user's request through
			// (optional ANVIL_DELEGATE_SYS prepends a system prompt); do NOT
			// forward our router system prompt, which asks for tool-call JSON.
			first := 1
			if len(delegate_sys) > 0 {
				mb = "{\"role\":\"system\",\"content\":\"" + json_esc(delegate_sys) + "\"}"
				first = 0
			}
			i := 0
			while i < len(ctx) {
				if first == 1 { first = 0 } else { mb = mb + "," }
				mb = mb + "{\"role\":\""
				if i % 2 == 0 { mb = mb + "user" } else { mb = mb + "assistant" }
				mb = mb + "\",\"content\":\"" + json_esc(ctx[i]) + "\"}"
				i = i + 1
			}
			if first == 0 { mb = mb + "," }
			mb = mb + "{\"role\":\"user\",\"content\":\"" + json_esc(state) + "\"}"
		}
		ub := "{\"messages\":[" + mb + "]"
		if len(delegate_model) > 0 { ub = ub + ",\"model\":\"" + json_esc(delegate_model) + "\"" }
		umt := dr.max_tokens
		if umt <= 0 { umt = 512 }
		ub = ub + ",\"max_tokens\":" + str(umt) + "}"
		hdrs := []string{"Content-Type: application/json"}
		if len(delegate_key) > 0 { hdrs = append(hdrs, "Authorization: Bearer " + delegate_key) }
		us, ubody, uerr := http_request("POST", delegate_url, hdrs, ub)
		if len(uerr) == 0 && us == 200 {
			ur := parse(ubody, UpResp{})
			if len(ur.choices) > 0 {
				content = ur.choices[0].message.content
				via = delegate_model
				if len(via) == 0 { via = delegate_url }
			}
		} else {
			reason = reason + "+upstream_error"
		}
	}
	lat := now_ms() - t0
	body := "{\"object\":\"route\",\"model\":\"" + model_id + "\",\"action\":\"" + action + "\",\"route\":\"" + json_esc(route) + "\",\"confidence\":" + str(conf) + ",\"p_yes\":" + str(py)
	if len(ghead.names) > 0 { body = body + ",\"domain\":\"" + json_esc(domain) + "\",\"gate_confidence\":" + str(gconf) + ",\"expert\":\"" + json_esc(expert) + "\"" }
	if set_size >= 0 { body = body + ",\"set_size\":" + str(set_size) + ",\"qhat\":" + str(qhat) }
	if len(via) > 0 { body = body + ",\"via\":\"" + json_esc(via) + "\"" }
	if len(tier) > 0 { body = body + ",\"tier\":\"" + json_esc(tier) + "\"" }
	body = body + ",\"reason\":\"" + reason + "\""
	if len(call_name) > 0 { body = body + ",\"call\":{\"name\":\"" + json_esc(call_name) + "\",\"arguments\":" + call_args + "}" }
	if len(content) > 0 { body = body + ",\"content\":\"" + json_esc(content) + "\"" }
	body = body + ",\"latency_ms\":" + str(lat) + "}"
	res = ok_json(body)
	lj := "{\"ts\":" + str(now_ms()) + ",\"ep\":\"route\",\"state\":\"" + json_esc(state) + "\",\"action\":\"" + action + "\",\"route\":\"" + json_esc(route) + "\",\"conf\":" + str(conf) + ",\"reason\":\"" + reason + "\"" + ",\"domain\":\"" + json_esc(domain) + "\",\"gate_conf\":" + str(gconf) + ",\"expert\":\"" + json_esc(expert) + "\""
	if set_size >= 0 { lj = lj + ",\"set_size\":" + str(set_size) }
	lj = lj + "}"
	log_decision(lj)
	met_acq <- 1
	mix := lane_ix(expert)
	lane_req[mix] = lane_req[mix] + 1
	if action == "delegate" { rt_del = rt_del + 1  lane_del[mix] = lane_del[mix] + 1 }
	if action == "tool_call" { rt_tc = rt_tc + 1 }
	rt_lat_sum = rt_lat_sum + float(lat)
	rt_lat_cnt = rt_lat_cnt + 1
	if set_size >= 0 { lane_ss_sum[mix] = lane_ss_sum[mix] + float(set_size)  lane_ss_cnt[mix] = lane_ss_cnt[mix] + 1 }
	met_rel <- 1
	return
}

// POST /v1/assess {"state": "<text>"} — every loaded head on ONE prefill pass:
// the Jev multi-question primitive. decide + noul + score all read the same
// s_x, so one forward pass answers all three questions.
func handle_assess(req) (res) {
	if hd_nr == 0 {
		res = ok_json("{\"error\":{\"message\":\"no decision head loaded (set ANVIL_HEAD)\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	dr := parse(req.body, DecideReq{})
	if len(dr.state) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state required\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	if head_prefill(dr.state, dr.context) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state exceeds model context length\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	apply_tenant_head(req)
	best := decide()
	py := 0.0
	if nl_head.nr > 0 {
		head_best(nl_head)
		if nl_yes >= 0 { py = peek_f32(nl_head.probs, nl_yes*4) }
	}
	sbest := -1
	if sc_head.nr > 0 { sbest = head_best(sc_head) }
	mu_rel <- 1
	body := "{\"object\":\"assess\",\"model\":\"" + model_id + "\",\"decision\":{\"choice\":\"" + json_esc(hd_names[best]) + "\",\"confidence\":" + str(peek_f32(hd_probs, best*4)) + "}"
	if nl_head.nr > 0 {
		ans := "no"
		if py >= 0.5 { ans = "yes" }
		body = body + ",\"noul\":{\"answer\":\"" + ans + "\",\"probability\":" + str(py) + "}"
	}
	if sc_head.nr > 0 {
		body = body + ",\"score\":{\"grade\":\"" + json_esc(sc_head.names[sbest]) + "\",\"confidence\":" + str(peek_f32(sc_head.probs, sbest*4)) + "}"
	}
	body = body + "}"
	res = ok_json(body)
	log_decision("{\"ts\":" + str(now_ms()) + ",\"ep\":\"assess\",\"state\":\"" + json_esc(dr.state) + "\",\"choice\":\"" + json_esc(hd_names[best]) + "\",\"conf\":" + str(peek_f32(hd_probs, best*4)) + ",\"p_yes\":" + str(py) + "}")
	return
}

var fb_log = ""
var fb_ips = []string{}
var fb_ts = []int{}
var fb_seq = 0

// POST /v1/feedback — cli-feedback-spec: open submit, size cap + per-IP
// rate limit, idempotent on client "id" (jsonl store at ANVIL_FEEDBACK_LOG).
// GET /v1/feedback is admin-gated (any valid ANVIL_KEYS bearer), 403 off.
func handle_feedback(req) (res) {
	if req.method == "GET" {
		if len(api_keys) == 0 || auth_ok(req) == 0 {
			res = ok_json("{\"ok\":false,\"error\":\"feedback reads are admin-gated\"}")
			res.status = "403 Forbidden"
			return
		}
		content := read_file(fb_log)
		items := ""
		lines := split(content, "\n")
		lim := parse_int(query(req, "limit"))
		if lim <= 0 { lim = 50 }
		i := len(lines) - 1
		n := 0
		while i >= 0 && n < lim {
			if len(lines[i]) > 0 {
				if len(items) > 0 { items = "," + items }
				items = lines[i] + items
				n = n + 1
			}
			i = i - 1
		}
		res = ok_json("{\"ok\":true,\"items\":[" + items + "]}")
		return
	}
	if len(req.body) > 16384 {
		res = ok_json("{\"ok\":false,\"error\":\"body exceeds 16384 bytes\"}")
		res.status = "413 Payload Too Large"
		return
	}
	now := now_ms()
	// sliding 60s per-IP window, 30/min
	nips := []string{}
	nts := []int{}
	cnt := 0
	i := 0
	while i < len(fb_ips) {
		if now - fb_ts[i] < 60000 {
			nips = append(nips, fb_ips[i])  nts = append(nts, fb_ts[i])
			if fb_ips[i] == req.remote { cnt = cnt + 1 }
		}
		i = i + 1
	}
	fb_ips = nips  fb_ts = nts
	if cnt >= 30 {
		res = ok_json("{\"ok\":false,\"error\":\"rate limit: 30/min per ip\"}")
		res.status = "429 Too Many Requests"
		return
	}
	mraw, merr := json_get(req.body, ".message")
	msg := unq(mraw)
	if len(merr) > 0 || len(trim(msg)) == 0 {
		res = ok_json("{\"ok\":false,\"error\":\"message required\"}")
		res.status = "400 Bad Request"
		return
	}
	fb_ips = append(fb_ips, req.remote)  fb_ts = append(fb_ts, now)
	fid := unq(jget_any(req.body, []string{".id"}))
	if len(fid) == 0 {
		fid = "fb-" + str(now) + "-" + str(fb_seq)
		fb_seq = fb_seq + 1
	}
	// idempotent: a stored id is a success no-op, never a duplicate row
	if index(read_file(fb_log), "\"id\":\"" + fid + "\"") >= 0 {
		res = ok_json("{\"ok\":true,\"id\":\"" + json_esc(fid) + "\",\"stored\":true}")
		return
	}
	kind := unq(jget_any(req.body, []string{".kind"}))
	if len(kind) == 0 { kind = "note" }
	line := "{\"id\":\"" + json_esc(fid) + "\",\"app\":\"mtlm-router\",\"version\":\"" + unq(jget_any(req.body, []string{".version"})) + "\",\"kind\":\"" + json_esc(kind) + "\",\"message\":\"" + json_esc(msg) + "\",\"context\":\"" + json_esc(unq(jget_any(req.body, []string{".context"}))) + "\",\"reporter\":\"" + json_esc(unq(jget_any(req.body, []string{".reporter"}))) + "\",\"remote\":\"" + req.remote + "\",\"ts\":" + str(now) + "}"
	off := file_size(fb_log)
	if off < 0 { off = 0 }
	write_file_at(fb_log, off, bytes(line + "\n"))
	res = ok_json("{\"ok\":true,\"id\":\"" + json_esc(fid) + "\",\"stored\":true}")
	return
}

// ---- POST /v1/systemone: Jev-compatible typed-question endpoint ----
// Contract (docs.typesafe.ai / github.com/us/jev-local):
//   {state, model, questions:{qid:{type:noul|choice|score, instructions, criteria}}}
//   -> {model, answers:{qid:{type, ...}}, usage:{input_tokens, output_tokens}}
// Scoring method (matches jev-local's HfLogprobScorer): one shared prompt
// prefix per question; each candidate is scored by teacher-forced mean
// logprob over the candidate's tokens only; softmax at per-head temperature.
// No generation. Candidate KV positions [np, ...) are overwritten per
// candidate; the prefix KV [0, np) stays valid — before scoring each
// candidate the last prefix token is re-forwarded to restore prefix logits.

// log p(tok) from the logits left in s_logits by the last forward
func s1_logp(tok) (lp) {
	mx := peek_f32(s_logits, 0)
	i := 1
	while i < vocab_size {
		v := peek_f32(s_logits, i*4)
		if v > mx { mx = v }
		i = i + 1
	}
	s := 0.0
	i = 0
	while i < vocab_size { s = s + exp(peek_f32(s_logits, i*4) - mx)  i = i + 1 }
	lp = peek_f32(s_logits, tok*4) - mx - log(s)
	return
}

// end index of the JSON value starting at i in s (string/number/object/array/bool)
func s1_span(s, i) (e) {
	e = i
	n := len(s)
	depth := 0
	instr := 0
	while e < n {
		ch := charat(s, e)
		if instr == 1 {
			if ch == "\\" { e = e + 1 } else { if ch == "\"" { instr = 0 } }
			e = e + 1
			continue
		}
		if ch == "\"" { instr = 1  e = e + 1  continue }
		if ch == "{" || ch == "[" { depth = depth + 1  e = e + 1  continue }
		if ch == "}" || ch == "]" {
			if depth == 0 { return }
			depth = depth - 1
			e = e + 1
			continue
		}
		if ch == "," && depth == 0 { return }
		e = e + 1
	}
	return
}

// top-level fields of a JSON object -> parallel key / raw-value slices
func s1_fields(obj) (keys, vals) {
	keys = []string{}
	vals = []string{}
	i := index(obj, "{")
	if i < 0 { return }
	i = i + 1
	n := len(obj)
	while i < n {
		c := charat(obj, i)
		if c == "}" { break }
		if c != "\"" { i = i + 1  continue }
		ks := i + 1
		j := ks
		while j < n {
			if charat(obj, j) == "\\" { j = j + 2  continue }
			if charat(obj, j) == "\"" { break }
			j = j + 1
		}
		keys = append(keys, substr(obj, ks, j))
		i = j + 1
		while i < n && charat(obj, i) != ":" { i = i + 1 }
		i = i + 1
		while i < n && (charat(obj, i) == " " || charat(obj, i) == "\n" || charat(obj, i) == "\t" || charat(obj, i) == "\r") { i = i + 1 }
		e := s1_span(obj, i)
		vals = append(vals, substr(obj, i, e))
		i = e
	}
	return
}

// elements of a JSON array -> raw-value slices (strings stay quoted)
func s1_elems(arr) (vals) {
	vals = []string{}
	i := index(arr, "[")
	if i < 0 { return }
	i = i + 1
	n := len(arr)
	while i < n {
		c := charat(arr, i)
		if c == "]" { break }
		if c == "," || c == " " || c == "\n" || c == "\t" || c == "\r" { i = i + 1  continue }
		e := s1_span(arr, i)
		vals = append(vals, substr(arr, i, e))
		i = e
	}
	return
}

// jev-local render_prefix: State/Question[/k means: v]/Answer with exactly
// one of: a | b[/Yes means:../No means:.. or Levels: 0 = l0, ...]/Answer:
func s1_prefix(state, instr, optkeys, optvals, levels, ntrue, nfalse) (p) {
	p = "State: " + state + "\nQuestion: " + instr + "\n"
	i := 0
	while i < len(optvals) {
		if len(optvals[i]) > 0 { p = p + optkeys[i] + " means: " + optvals[i] + "\n" }
		i = i + 1
	}
	if len(optkeys) > 0 {
		p = p + "Answer with exactly one of: "
		i = 0
		while i < len(optkeys) {
			if i > 0 { p = p + " | " }
			p = p + optkeys[i]
			i = i + 1
		}
		p = p + "\n"
	}
	if len(ntrue) > 0 && len(nfalse) > 0 {
		p = p + "Yes means: " + ntrue + "\nNo means: " + nfalse + "\n"
	} else {
		if len(levels) > 0 {
			p = p + "Levels: "
			i = 0
			while i < len(levels) {
				if i > 0 { p = p + ", " }
				p = p + str(i) + " = " + levels[i]
				i = i + 1
			}
			p = p + "\n"
		}
	}
	p = p + "Answer:"
	return
}

// mean logprob of candidate tokens ctoks occupying positions [np, np+len);
// s_logits must hold the next-token distribution for position np on entry
func s1_cand_mean(np, ctoks) (m) {
	m = 0.0
	if len(ctoks) == 0 { return }
	sum := s1_logp(ctoks[0])
	if s1_first_tok == 1 { m = sum  return }
	i := 1
	while i < len(ctoks) {
		forward(ctoks[i-1], np+i-1)
		sum = sum + s1_logp(ctoks[i])
		i = i + 1
	}
	m = sum / float(len(ctoks))
	return
}

// candidate token list for `cand` continuing prefix tokens ptoks: encode
// prefix+" "+cand, drop the longest common leading run (tokenization is not
// prefix-preserving at the join — jev-local does the same)
func s1_cand_toks(prefix, ptoks, cand) (ctoks) {
	ctoks = []int{}
	if s1_chat == 1 {
		// prompt ends at the assistant header — the candidate is the reply's
		// first tokens; encode the continuation directly
		return bpe_encode_raw(" " + cand)
	}
	full := bpe_encode_raw(prefix + " " + cand)
	k := 0
	n := len(ptoks)
	if len(full) < n { n = len(full) }
	while k < n && ptoks[k] == full[k] { k = k + 1 }
	i := k
	while i < len(full) { ctoks = append(ctoks, full[i])  i = i + 1 }
	return
}

func s1_softmax(means, temp) (probs) {
	probs = []float{}
	if len(means) == 0 { return }
	mx := means[0]
	i := 1
	while i < len(means) { if means[i] > mx { mx = means[i] }  i = i + 1 }
	sum := 0.0
	i = 0
	while i < len(means) {
		e := exp((means[i] - mx) / temp)
		probs = append(probs, e)
		sum = sum + e
		i = i + 1
	}
	i = 0
	while i < len(probs) { probs[i] = probs[i] / sum  i = i + 1 }
	return
}

// score one question against the prefill'd prefix; returns the answer JSON
// ("" + err on failure). Caller holds the model lock.
func s1_answer(qid, qv, state) (aj, err, ntoks) {
	aj = ""
	err = ""
	ntoks = 0
	qtype, _ := json_get(qv, ".type")
	qtype = unq(qtype)
	instr, _ := json_get(qv, ".instructions")
	instr = unq(instr)
	crit, _ := json_get(qv, ".criteria")
	optkeys := []string{}
	optvals := []string{}
	levels := []string{}
	cands := []string{}
	ntrue := ""
	nfalse := ""
	if qtype == "noul" {
		if len(crit) > 0 {
			ck, cv := s1_fields(crit)
			i := 0
			while i < len(ck) {
				if ck[i] != "true" && ck[i] != "false" { err = qid + ": noul criteria keys must be true/false"  return }
				i = i + 1
			}
			t, _ := json_get(crit, ".true")
			f, _ := json_get(crit, ".false")
			ntrue = unq(t)
			nfalse = unq(f)
		}
		optkeys = append(optkeys, "Yes")
		optkeys = append(optkeys, "No")
		cands = optkeys
	}
	if qtype == "choice" {
		ck, cv := s1_fields(crit)
		if len(ck) == 0 {
			// options-array shorthand: "options": ["billing", "technical"]
			// (some clients send this instead of a criteria map)
			op, _ := json_get(qv, ".options")
			oe := s1_elems(op)
			i := 0
			while i < len(oe) { ck = append(ck, unq(oe[i]))  i = i + 1 }
			cv = []string{}
		}
		if len(ck) == 0 { err = qid + ": choice criteria must not be empty"  return }
		if len(ck) > 255 { err = qid + ": choice accepts up to 255 options"  return }
		optkeys = ck
		i := 0
		while i < len(cv) { optvals = append(optvals, unq(cv[i]))  i = i + 1 }
		cands = ck
		if s1_cand_desc == 1 {
			// description verbalizers beat bare keys on base trunks
			dc := []string{}
			i = 0
			while i < len(optkeys) {
				if i < len(optvals) && len(optvals[i]) > 0 { dc = append(dc, optvals[i]) } else { dc = append(dc, optkeys[i]) }
				i = i + 1
			}
			cands = dc
		}
	}
	if qtype == "score" {
		levels = []string{}
		lv := s1_elems(crit)
		i := 0
		while i < len(lv) { levels = append(levels, unq(lv[i]))  i = i + 1 }
		if len(levels) < 2 || len(levels) > 10 { err = qid + ": score needs 2..10 levels"  return }
		if s1_cand_desc == 1 {
			cands = levels
		} else {
			i = 0
			while i < len(levels) { cands = append(cands, str(i))  i = i + 1 }
		}
	}
	if qtype != "noul" && qtype != "choice" && qtype != "score" {
		err = qid + ": unknown question type " + qtype
		return
	}
	probs := []float{}
	if s1_yes >= 0 {
		// trained entailment scorer: one prefill per candidate on the same
		// "State/Question/Option/Correct?" prompt shape the head was fit on
		probs = []float{}
		if qtype == "noul" {
			// one shot: does the instruction itself hold? criteria true-desc wins
			ot := "the answer is yes"
			if len(ntrue) > 0 { ot = ntrue }
			content := "State: " + state + "\nQuestion: " + instr + "\nOption: " + ot + "\nCorrect?"
			if head_prefill_locked(content, []string{}) == 0 { err = qid + ": state too long"  return }
			head_best(s1_head)
			probs = append(probs, peek_f32(s1_head.probs, s1_yes*4))
			probs = append(probs, 1.0 - probs[0])
		} else {
			ci := 0
			while ci < len(cands) {
				ot := cands[ci]
				if qtype == "choice" && ci < len(optvals) && len(optvals[ci]) > 0 { ot = optvals[ci] }
				if qtype == "score" && ci < len(levels) { ot = levels[ci] }
				content := "State: " + state + "\nQuestion: " + instr + "\nOption: " + ot + "\nCorrect?"
				if head_prefill_locked(content, []string{}) == 0 { err = qid + ": state too long"  return }
				head_best(s1_head)
				probs = append(probs, peek_f32(s1_head.probs, s1_yes*4))
				ci = ci + 1
			}
			sum := 0.0
			ci = 0
			while ci < len(probs) { sum = sum + probs[ci]  ci = ci + 1 }
			if sum > 0.0 { ci = 0  while ci < len(probs) { probs[ci] = probs[ci] / sum  ci = ci + 1 } }
		}
	} else {
		prefix := s1_prefix(state, instr, optkeys, optvals, levels, ntrue, nfalse)
		ptoks := bpe_encode_raw(prefix)
		if s1_chat == 1 {
			cm := ChatMsg{}  cm.role = "user"  cm.content = prefix
			cms := []ChatMsg{}  cms = append(cms, cm)
			ptoks = chat_tokens(cms)
		}
		np := len(ptoks)
		if np + 32 >= seq_len { err = qid + ": state too long"  return }
		ntoks = np
		start := cache_common(ptoks)
		if start >= np { start = np - 1 }
		i := start
		while i < np { forward(ptoks[i], i)  i = i + 1 }
		// advertise only the prefix: candidate KV positions [np, ...) are scratch
		i = 0
		while i < np { poke_i32(cache_buf, i*4, ptoks[i])  i = i + 1 }
		cache_len = np
		means := []float{}
		ci := 0
		while ci < len(cands) {
			ctoks := s1_cand_toks(prefix, ptoks, cands[ci])
			if len(ctoks) == 0 { err = qid + ": candidate scores zero tokens"  return }
			if np + len(ctoks) >= seq_len { err = qid + ": candidate too long"  return }
			forward(ptoks[np-1], np-1)
			means = append(means, s1_cand_mean(np, ctoks))
			ntoks = ntoks + len(ctoks)
			ci = ci + 1
		}
		temp := s1_t_choice
		if qtype == "noul" { temp = s1_t_noul }
		if qtype == "score" { temp = s1_t_score }
		probs = s1_softmax(means, temp)
	}
	bi := 0
	i = 1
	while i < len(probs) { if probs[i] > probs[bi] { bi = i }  i = i + 1 }
	if qtype == "noul" {
		aj = "{\"type\":\"noul\",\"noul\":" + str(probs[0]) + "}"
		return
	}
	if qtype == "choice" {
		pj := ""
		i = 0
		while i < len(cands) {
			if i > 0 { pj = pj + "," }
			pj = pj + "\"" + json_esc(cands[i]) + "\":" + str(probs[i])
			i = i + 1
		}
		aj = "{\"type\":\"choice\",\"choice\":\"" + json_esc(cands[bi]) + "\",\"probabilities\":{" + pj + "},\"confidence\":" + str(probs[bi]) + "}"
		return
	}
	pj := ""
	lj := ""
	ev := 0.0
	i = 0
	while i < len(levels) {
		if i > 0 { pj = pj + ","  lj = lj + "," }
		pj = pj + "\"" + str(i) + "\":" + str(probs[i])
		lj = lj + "\"" + str(i) + "\":\"" + json_esc(levels[i]) + "\""
		ev = ev + float(i) * probs[i]
		i = i + 1
	}
	aj = "{\"type\":\"score\",\"score\":" + str(ev) + ",\"legend\":{" + lj + "},\"probabilities\":{" + pj + "},\"confidence\":" + str(probs[bi]) + "}"
	return
}

func handle_systemone(req) (res) {
	st, _ := json_get(req.body, ".state")
	st = unq(st)
	if len(st) == 0 {
		res = ok_json("{\"error\":{\"message\":\"state required\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	qraw, _ := json_get(req.body, ".questions")
	qkeys, qvals := s1_fields(qraw)
	if len(qkeys) == 0 {
		res = ok_json("{\"error\":{\"message\":\"questions required\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	lk := <-mu_acq
	lk = lk
	t0 := now_ms()
	aj := ""
	errmsg := ""
	toks := 0
	i := 0
	while i < len(qkeys) {
		a, e, n := s1_answer(qkeys[i], qvals[i], st)
		if len(e) > 0 { errmsg = e  break }
		if len(aj) > 0 { aj = aj + "," }
		aj = aj + "\"" + json_esc(qkeys[i]) + "\":" + a
		toks = toks + n
		i = i + 1
	}
	mu_rel <- 1
	if len(errmsg) > 0 {
		etype := "invalid_request_error"
		if contains(errmsg, "too long") { etype = "max_tokens_exceeded" }
		res = ok_json("{\"error\":{\"message\":\"" + json_esc(errmsg) + "\",\"type\":\"" + etype + "\"}}")
		res.status = "422 Unprocessable Entity"
		return
	}
	body := "{\"model\":\"" + model_id + "\",\"answers\":{" + aj + "},\"usage\":{\"input_tokens\":" + str(toks) + ",\"output_tokens\":" + str(len(qkeys)) + "}}"
	res = ok_json(body)
	stl := len(st)
	if stl > 120 { stl = 120 }
	log_decision("{\"ts\":" + str(now_ms()) + ",\"ep\":\"systemone\",\"state\":\"" + json_esc(substr(st, 0, stl)) + "\",\"n_q\":" + str(len(qkeys)) + ",\"ms\":" + str(now_ms()-t0) + "}")
	return
}

func api_route(req) (res) {
	if req.method == "POST" && has_prefix(req.path, "/v1/feedback") { res = handle_feedback(req)  return }
	if req.method == "GET" && has_prefix(req.path, "/v1/feedback") { res = handle_feedback(req)  return }
	if len(api_keys) > 0 && has_prefix(req.path, "/v1/") && auth_ok(req) == 0 {
		res = ok_json("{\"error\":{\"message\":\"missing or invalid api key\",\"type\":\"invalid_request_error\"}}")
		res.status = "401 Unauthorized"
		return
	}
	if req.method == "GET" && req.path == "/v1/models" { res = handle_models()  return }
	if req.method == "POST" && req.path == "/v1/chat/completions" { met_ep(0)  res = handle_chat(req)  return }
	if req.method == "POST" && req.path == "/v1/decide" { met_ep(1)  res = handle_decide(req)  return }
	if req.method == "POST" && req.path == "/v1/route" { res = handle_route(req)  return }
	if req.method == "POST" && req.path == "/v1/assess" { met_ep(2)  res = handle_assess(req)  return }
	if req.method == "POST" && req.path == "/v1/noul" { met_ep(3)  res = handle_noul(req)  return }
	if req.method == "POST" && req.path == "/v1/score" { met_ep(4)  res = handle_score(req)  return }
	if req.method == "POST" && req.path == "/v1/systemone" { met_ep(5)  res = handle_systemone(req)  return }
	if req.method == "GET" && req.path == "/health" { res = ok_json("{\"ok\":true,\"model\":\"" + model_id + "\"}")  return }
	if req.method == "GET" && req.path == "/livez" { res = ok_json("{\"ok\":true}")  return }
	if req.method == "GET" && req.path == "/readyz" { res = handle_ready()  return }
	if req.method == "GET" && req.path == "/v1/lanes" { res = handle_lanes()  return }
	if req.method == "GET" && req.path == "/_health" {
		hc, hout, herr := exec("echo $PPID")
		res = ok_json("{\"ok\":true,\"service\":\"anvil-serve\",\"model\":\"" + model_id + "\",\"pid\":" + trim(hout) + "}")
		return
	}
	if req.method == "GET" && req.path == "/guide" { res = handle_guide()  return }
	if req.method == "GET" && req.path == "/llms.txt" { res = handle_llms()  return }
	if req.method == "GET" && (req.path == "/metrics" || req.path == "/_metrics") { res = handle_metrics()  return }
	if req.method == "GET" && req.path == "/v1/whoami" { res = handle_whoami(req)  return }
	if req.method == "POST" && req.path == "/_shutdown" { res = handle_shutdown(req)  return }
	if req.path == "/_qhat" { res = handle_qhat(req)  return }
	res = ok_json("{\"error\":{\"message\":\"not found\",\"type\":\"invalid_request_error\"}}")
	res.status = "404 Not Found"
	return
}

func main() {
	a := args()
	model := "models/tinyllama-1.1b-q80.bin"
	port := 8090
	if len(a) > 1 { model = a[1] }
	if len(a) > 2 { port = parse_int(a[2]) }
	nw := parse_int(env("COLIBRI_THREADS"))
	if nw > 0 { n_workers = nw } else { n_workers = 6 }
	if parse_int(env("COLIBRI_NOBATCH")) == 1 { pb_enabled = 0 }
	if parse_int(env("COLIBRI_SPEC")) == 1 { spec_enabled = 1 }
	if parse_int(env("COLIBRI_SPARSE")) == 1 { sparse_probe = 1 }
	el := parse_int(env("COLIBRI_EXIT_LAYER"))
	if el > 0 { exit_layer = el }
	sk := parse_int(env("COLIBRI_SPEC_K"))
	if sk > 0 { spec_k = sk }
	tl := parse_int(env("COLIBRI_TILE"))
	if tl > 0 { pb_tile = tl } // must be set before alloc_state sizes the batch buffers
	t0 := now_ms()
	load_model(model)
	alloc_state()
	load_tokenizer_auto()
	hp := env("ANVIL_HEAD")
	if len(hp) > 0 { load_head(hp) }
	np2 := env("ANVIL_NOUL")
	if len(np2) > 0 { load_noul(np2) }
	sp := env("ANVIL_SCORE")
	if len(sp) > 0 { load_score(sp) }
	decide_log = env("ANVIL_LOG")
	fb_log = env("ANVIL_FEEDBACK_LOG")
	if len(fb_log) == 0 { fb_log = "feedback.jsonl" }
	delegate_url = env("ANVIL_DELEGATE_URL")
	delegate_key = env("ANVIL_DELEGATE_KEY")
	delegate_model = env("ANVIL_DELEGATE_MODEL")
	delegate_sys = env("ANVIL_DELEGATE_SYS")
	if len(delegate_url) > 0 { println("route delegation upstream: " + delegate_url) }
	ak := env("ANVIL_KEYS")
	if len(ak) > 0 {
		api_keys = split(ak, ",")
		i := 0
		while i < len(api_keys) { api_keys[i] = trim(api_keys[i])  i = i + 1 }
		println("api auth: " + str(len(api_keys)) + " key(s) required on /v1/*")
	}
	tn := env("ANVIL_TENANTS")
	if len(tn) > 0 {
		if hd_nr == 0 { println("ANVIL_TENANTS requires ANVIL_HEAD (the default head)")  exit(1) }
		def_head = cur_head()
		tp := split(tn, ",")
		i := 0
		while i < len(tp) {
			sep := index(tp[i], ":")
			if sep > 0 {
				tkeys = append(tkeys, trim(substr(tp[i], 0, sep)))
				// preload+validate now: main-goroutine arena is permanent, and
				// a bad tenant head fails the boot instead of a request.
				thead = append(thead, read_head(trim(substr(tp[i], sep + 1, len(tp[i])))))
			}
			i = i + 1
		}
		println("tenants: " + str(len(tkeys)) + " key->head mapping(s)")
	}
	gp := env("ANVIL_GATE")
	if len(gp) > 0 {
		if hd_nr == 0 { println("ANVIL_GATE requires ANVIL_HEAD (the fallback expert head)")  exit(1) }
		ghead = read_head(gp)
		if len(tkeys) == 0 { def_head = cur_head() }
		gm := parse_float(env("ANVIL_GATE_MINCONF"))
		if gm > 0.0 { gate_minconf = gm }
		println("gate: " + str(ghead.nr) + " domains -> " + str(len(edomains)) + " expert head(s) (minconf=" + str(gate_minconf) + ")")
	}
	// experts register with or without a gate: a pinned-only deployment
	// (ANVIL_EXPERTS="acme:acme.head", no gate) serves known-domain clients
	// that never send mixed traffic.
	ex := env("ANVIL_EXPERTS")
	if len(ex) > 0 {
		xp := split(ex, ",")
		i := 0
		while i < len(xp) {
			sep := index(xp[i], ":")
			if sep > 0 {
				edomains = append(edomains, trim(substr(xp[i], 0, sep)))
				eheads = append(eheads, read_head(trim(substr(xp[i], sep + 1, len(xp[i])))))
			}
			i = i + 1
		}
		println("experts: " + str(len(edomains)) + " pinned lane(s)")
	}
	// metric arrays are per-lane with a trailing "default" bucket for
	// requests that don't resolve to a pinned expert (gate fallback).
	i := 0
	while i < len(edomains) { lane_names_out = append(lane_names_out, edomains[i])  i = i + 1 }
	lane_names_out = append(lane_names_out, "default")
	i = 0
	while i < len(lane_names_out) { lane_req = append(lane_req, 0)  lane_del = append(lane_del, 0)  lane_ss_sum = append(lane_ss_sum, 0)  lane_ss_cnt = append(lane_ss_cnt, 0)  i = i + 1 }
	emc_env := env("ANVIL_EXPERT_MINCONF")
	if len(emc_env) > 0 {
		ep := split(emc_env, ",")
		i := 0
		while i < len(ep) {
			sep := index(ep[i], ":")
			if sep > 0 {
				emin_names = append(emin_names, trim(substr(ep[i], 0, sep)))
				emin_vals = append(emin_vals, parse_float(trim(substr(ep[i], sep + 1, len(ep[i])))))
			}
			i = i + 1
		}
		println("expert minconf overrides: " + str(len(emin_names)))
	}
	cq_env := env("ANVIL_EXPERT_QHAT")
	if len(cq_env) > 0 {
		ep := split(cq_env, ",")
		i := 0
		while i < len(ep) {
			sep := index(ep[i], ":")
			if sep > 0 {
				cq_names = append(cq_names, trim(substr(ep[i], 0, sep)))
				cq_vals = append(cq_vals, parse_float(trim(substr(ep[i], sep + 1, len(ep[i])))))
			}
			i = i + 1
		}
		println("expert conformal qhats: " + str(len(cq_names)))
	}
	conf_qhat = parse_float(env("ANVIL_CONFORMAL_QHAT"))
	st := parse_float(env("ANVIL_S1_T"))
	if st > 0.0 { s1_t_choice = st  s1_t_noul = st  s1_t_score = st }
	stc := parse_float(env("ANVIL_S1_T_CHOICE"))
	if stc > 0.0 { s1_t_choice = stc }
	stn := parse_float(env("ANVIL_S1_T_NOUL"))
	if stn > 0.0 { s1_t_noul = stn }
	sts := parse_float(env("ANVIL_S1_T_SCORE"))
	if sts > 0.0 { s1_t_score = sts }
	if env("ANVIL_S1_CHAT") == "1" { s1_chat = 1  println("systemone: chat-template wrap on") }
	if env("ANVIL_S1_CAND") == "desc" { s1_cand_desc = 1  println("systemone: scoring criteria descriptions") }
	if env("ANVIL_S1_FIRSTTOK") == "1" { s1_first_tok = 1 }
	sh := env("ANVIL_S1_HEAD")
	if len(sh) > 0 {
		s1_head = read_head(sh)
		i := 0
		while i < s1_head.nr { if s1_head.names[i] == "yes" { s1_yes = i }  i = i + 1 }
		if s1_yes < 0 { println("ANVIL_S1_HEAD: no 'yes' route — head scoring off")  s1_head = zero_head() }
		else { println("systemone: entailment head " + sh + " (yes_idx=" + str(s1_yes) + ")") }
	}
	if conf_qhat > 0.0 { println("conformal qhat (default head): " + str(conf_qhat)) }
	// head pooling: mhd2 heads self-describe the (kind, layer) tap they were
	// trained on — mixed pooling configs coexist on one instance. ANVIL_POOL=
	// max|mean overrides all heads to one tap (legacy/global mode); layer via
	// ANVIL_POOL_LAYER, negative counts from the top (-2 default), "final" =
	// post-norm s_x.
	pool_env := env("ANVIL_POOL")
	env_kind := 0
	if pool_env == "max" { env_kind = 1 }
	if pool_env == "mean" { env_kind = 2 }
	if env_kind > 0 {
		el := -2
		pl := env("ANVIL_POOL_LAYER")
		if pl == "final" {
			el = n_layers
		} else {
			pi := parse_int(pl)
			if pi != 0 { el = pi }
			if el < 0 { el = n_layers + el }
			if el < 0 || el > n_layers { println("bad ANVIL_POOL_LAYER " + pl)  exit(1) }
		}
		envi := pt_register(env_kind, el)
		// the env forces every loaded head onto this one tap — a mismatch with
		// a head's declared flags serves garbage silently, so warn loudly.
		want_flags := env_kind | ((el + 1) << 4)
		hd_feat = envi
		def_head.feat = envi
		if len(hd_feats) > 0 { println("warn: ANVIL_POOL ignored by mhd3 head " + hd_path) }
		if hd_flags != 0 && hd_flags != want_flags { println("warn: head " + hd_path + " flags=" + str(hd_flags) + " != ANVIL_POOL config " + str(want_flags)) }
		if len(ghead.names) > 0 {
			ghead.feat = envi
			if ghead.flags != 0 && ghead.flags != want_flags { println("warn: head " + ghead.path + " flags=" + str(ghead.flags) + " != ANVIL_POOL config " + str(want_flags)) }
		}
		i := 0
		while i < len(eheads) {
			eheads[i].feat = envi
			if len(eheads[i].feats) > 0 { println("warn: ANVIL_POOL ignored by mhd3 head " + eheads[i].path) }
			if eheads[i].flags != 0 && eheads[i].flags != want_flags { println("warn: head " + eheads[i].path + " flags=" + str(eheads[i].flags) + " != ANVIL_POOL config " + str(want_flags)) }
			i = i + 1
		}
		i = 0
		while i < len(thead) {
			thead[i].feat = envi
			if thead[i].flags != 0 && thead[i].flags != want_flags { println("warn: head " + thead[i].path + " flags=" + str(thead[i].flags) + " != ANVIL_POOL config " + str(want_flags)) }
			i = i + 1
		}
		println("pooling: " + pool_env + " layer=" + str(el) + " (env override on all heads)")
	}
	if len(pt_kinds) > 0 && env_kind == 0 {
		i := 0
		while i < len(pt_kinds) {
			println("pool tap: kind=" + str(pt_kinds[i]) + " layer=" + str(pt_layers[i]))
			i = i + 1
		}
	}
	if tok_l3 == 1 { model_id = "llama-3.2-1b-instruct-q80" }
	// model id shown in responses: basename of the model file, or
	// ANVIL_MODEL_ID to override entirely.
	if len(a) > 1 {
		mid := model
		mi := index(mid, "/")
		while mi >= 0 { mid = substr(mid, mi + 1, len(mid))  mi = index(mid, "/") }
		if has_suffix(mid, ".bin") { mid = substr(mid, 0, len(mid) - 4) }
		if has_suffix(mid, ".mtlm") { mid = substr(mid, 0, len(mid) - 5) }
		if len(mid) > 0 { model_id = mid }
	}
	mido := env("ANVIL_MODEL_ID")
	if len(mido) > 0 { model_id = mido }
	// skills are OPT-IN (COLIBRI_SKILLS=<dir>): measured to HURT reliability on
	// the 1B baseline (see bench/SKILLS-EVAL.md — the M6 prompt+parser already
	// saturate tool reliability, so extra context only adds drift). The mechanism
	// ships for weaker baselines / bigger models; default is no skills.
	skills_dir := env("COLIBRI_SKILLS")
	if len(skills_dir) > 0 { load_skills(skills_dir) }
	w := 0
	while w < n_workers { go worker(jobs, done)  w = w + 1 }
	go mutex_srv(mu_acq, mu_rel)
	go mutex_srv(met_acq, met_rel)
	boot_ms = now_ms()
	println("colibri serve: model=" + model_id + " dim=" + str(dim) + " layers=" + str(n_layers) + " workers=" + str(n_workers) + " skills=" + str(len(skills)) + " loaded in " + str(now_ms() - t0) + " ms")
	// ANVIL_BIND=<addr> binds a specific interface (e.g. 127.0.0.1 when the
	// mtlm-router wrapper runs the daemon loopback-only by default); unset =
	// the historical appliance-wide 0.0.0.0.
	bind := env("ANVIL_BIND")
	if len(bind) == 0 { bind = "0.0.0.0" }
	println("OpenAI-compatible API on http://" + bind + ":" + str(port) + "/v1")
	flush()
	serve_on_quiet(bind, port, func(req) { return api_route(req) })
}
